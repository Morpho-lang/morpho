// ComplexMatrix-valued Field

var m = Mesh("square.mesh")
print m
// expect: <Mesh: 4 vertices>

var f = Field(m, ComplexMatrix(((1+im, 0), (0, 1-im))))

print f[0]
// expect: [ 1 + 1im 0 + 0im ]
// expect: [ 0 + 0im 1 - 1im ]

f[1] = ComplexMatrix(((2, 0), (0, 2im)))
print f[1]
// expect: [ 2 + 0im 0 + 0im ]
// expect: [ 0 + 0im 0 + 2im ]

var g = f+f
print g[0]
// expect: [ 2 + 2im 0 + 0im ]
// expect: [ 0 + 0im 2 - 2im ]

print f.sum()
// expect: [ 5 + 3im 0 + 0im ]
// expect: [ 0 + 0im 3 - 1im ]

print f.linearize().clss()
// expect: @Matrix

print f.clss()
// expect: @ComplexMatrixField

print (f+f).clss()
// expect: @ComplexMatrixField

print f.clone().clss()
// expect: @ComplexMatrixField

var h = Field(m, fn (x, y, z) ComplexMatrix([1+im, 2]))
print h[0]
// expect: [ 1 + 1im ]
// expect: [ 2 + 0im ]
