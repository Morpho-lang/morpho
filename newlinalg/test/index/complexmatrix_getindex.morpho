// Get elements of a ComplexMatrix

import newlinalg 

var A = ComplexMatrix(2,2)
A[0,0] = 1+1im
A[1,0] = 2+2im
A[0,1] = 3+3im
A[1,1] = 4+4im

// Array-like access
print A[0,0] // expect: 1 + 1im
print A[1,0] // expect: 2 + 2im
print A[0,1] // expect: 3 + 3im
print A[1,1] // expect: 4 + 4im

// Vector-like access
print A[0] // expect: 1 + 1im
print A[1] // expect: 2 + 2im
print A[2] // expect: 3 + 3im
print A[3] // expect: 4 + 4im
