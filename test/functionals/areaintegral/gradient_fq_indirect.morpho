// Indirect grad() via captured global must error on a fast-path shape gradient.

import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))
var grd = grad

fn sneaky(x, qv) {
    var g = grd(qv)
    return g[0].inner(g[0])
}

var bulk = AreaIntegral(sneaky, q)
print bulk.gradient(m)
// expect error 'IntgrlFstPath'
