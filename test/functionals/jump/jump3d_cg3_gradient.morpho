import meshtools
import "../numericalderivatives.morpho"

var mb = MeshBuilder()
mb.addvertex([0,0,0])
mb.addvertex([1,0,0])
mb.addvertex([0,1,0])
mb.addvertex([0,0,1])
mb.addvertex([0,0,-1])
mb.addvolume([0,1,2,3])
mb.addvolume([0,1,2,4])

var m = mb.build()
m.addgrade(1)
m.addgrade(2)

var fe = FiniteElementSpace("CG3", grade=3)
var f = Field(m, fn (x,y,z) x*y*z^2, finiteelementspace=fe)

var j = Jump(fn (x, q) jumpdn(q)^2, f, method={ "strategy": "quadrature" })
var tol = 2e-5

print (j.gradient(m) - numericalgradient(j, m)).norm() < tol
// expect: true

print (j.fieldgradient(m, f) - numericalfieldgradient(j, m, f)).linearize().norm() < tol
// expect: true
