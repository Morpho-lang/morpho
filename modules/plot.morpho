/* ***************************************************************
 * Plot
 * ====
 * Visualize a Mesh, Field, or Selection as a Scene.
 **************************************************************** */

/* ----------------------------------------------------------------
 * The plot module provides:
 * - Plot : Scene of mesh / selection / field geometry
 * - ScaleBar / ScaleBarStrip : colormap legends
 * - plotmesh / plotselection / plotfield : legacy constructors
 * - plotaxes / plotmeshlabels : annotation helpers
 * ---------------------------------------------------------------- */

import constants
import graphics
import color

// Error messages
var _PltFldIntErr = Error("PltFldInt", "Can't use 'interpolate' style: Field lacks values on vertices.")
var _PltSlctnEmptyErr = Error("PltSlctnEmpty", "Selection is empty.")
var _PltSclBrVctrErr = Error("PltSclBrVctr", "ScaleBar vector must be a non-zero Matrix, List, or Tuple; tickdirn must not be parallel to dirn.")

/* ----------------------------------------------------------------
 * Bounding boxes
 * ---------------------------------------------------------------- */

fn _meshBounds(Mesh mesh) { // Min and max of each coordinate of the mesh vertices
  var m = mesh.vertexmatrix()
  var n = m.dimensions()[1]
  var bnds = []
  for (i in 0...m.dimensions()[0]) bnds.append(bounds(m[i, 0...n]))
  return bnds
}

fn _boundsLoHi(bnds) { // Lower and upper corners as 3-vectors, plus how many axes the mesh has
  var dim = bnds.count()
  var lo = Matrix(3)
  var hi = Matrix(3)
  for (i in 0...dim) {
    lo[i] = bnds[i][0]
    hi[i] = bnds[i][1]
  }
  return (lo, hi, dim)
}

fn _boundsEqual(a, b) { // Same axis count and lo/hi, within a tight tolerance
  if (isnil(a) && isnil(b)) return true
  if (isnil(a) || isnil(b)) return false
  if (a.count() != b.count()) return false
  for (i in 0...a.count()) {
    if (abs(a[i][0] - b[i][0]) > 1e-12) return false
    if (abs(a[i][1] - b[i][1]) > 1e-12) return false
  }
  return true
}

fn _boundsUnion(a, b) { // Axis-aligned union; nil is treated as empty
  if (isnil(a)) return b
  if (isnil(b)) return a
  var n = a.count()
  if (b.count() > n) n = b.count()
  var out = []
  for (i in 0...n) {
    if (i >= a.count()) { out.append(b[i]); continue }
    if (i >= b.count()) { out.append(a[i]); continue }
    var lo = a[i][0]
    var hi = a[i][1]
    if (b[i][0] < lo) lo = b[i][0]
    if (b[i][1] > hi) hi = b[i][1]
    out.append((lo, hi))
  }
  return out
}

fn _planarAxis(bb) { // Which axis has zero width, or nil if none
  for (x, i in bb) {
    if (abs(x[1]-x[0])<1e-10) return i
  }
  return nil
}

fn _ptOnAxis(Matrix lo, ax, t) { // Point on axis ax at coordinate t; other coordinates taken from the box corner
  var p = lo.clone()
  p[ax] = t
  return p
}

fn _vertexMatrix3(mesh) { // Vertex matrix with three coordinates per vertex (missing ones are zero)
  var v = mesh.vertexmatrix()
  var d = v.dimensions()[0]
  var n = v.dimensions()[1]
  if (d == 3) return v
  if (n == 0) return Matrix(3, 0)
  if (d > 3) return v[0...3, 0...n]
  var out = Matrix(3, n)
  out[0...d, 0...n] = v
  return out
}

fn _to3D(Matrix x) { // 3-vector, padding with zeros if the input is shorter
  var n = min(x.count(), 3)
  var y = Matrix(3)
  y[0...n, 0] = x[0...n, 0]
  return y
}

fn _centroid(m, g, id) { // Average position of a mesh element
  if (g == 0) return m.vertexposition(id)
  var el = m.connectivitymatrix(0, g).rowindices(id)
  var x = 0
  for (vid in el) x += m.vertexposition(vid)
  return x/el.count()
}

/* ----------------------------------------------------------------
 * Grade / style predicates
 * ---------------------------------------------------------------- */

fn _plotTri(conn, i, a, b, c) { // Record triangle i with vertices a, b, c
  conn[a, i] = 1; conn[b, i] = 1; conn[c, i] = 1
  conn.setrowindices(i, (a, b, c))
}

fn _gradeList(mesh) { return [mesh.maxgrade()] } // List of mesh grades to draw
fn _gradeList(mesh, List grade) { return grade.clone() }
fn _gradeList(mesh, Int grade) { return [grade] }
fn _gradeList(mesh, Float grade) { return [grade] }
fn _gradeList(mesh, grade) {
  if (isnil(grade)) return [mesh.maxgrade()]
  if (istuple(grade)) {
    var out = []
    for (x in grade) out.append(x)
    return out
  }
  if (isnumber(grade)) return [grade]
  return [mesh.maxgrade()]
}

fn _wantsGrade(List grade, g) { return grade.ismember(g) } // True if this grade should be drawn
fn _wantsGrade(Int grade, g) { return grade == g }
fn _wantsGrade(Float grade, g) { return grade == g }
fn _wantsGrade(grade, g) {
  if (isnil(grade)) return true
  if (isnumber(grade)) return grade == g
  if (istuple(grade)) {
    for (x in grade) if (x == g) return true
    return false
  }
  return true
}

fn _styleHas(String style, name) { return style == name } // True if the plot style includes this name
fn _styleHas(List style, name) { return style.ismember(name) }
fn _styleHas(style, name) {
  if (isnil(style)) return false
  if (isarray(style)) return style.ismember(name)
  if (istuple(style)) {
    for (x in style) if (x == name) return true
    return false
  }
  return style == name
}

fn _legacyStyle(style) { // Use spheres and tubes when the caller omitted style=
  if (isnil(style)) return "thick"
  return style
}

fn _plotLegacyTransp(color, filter, transmit) { // [Compatibility shim] Apply deprecated filter=/transmit= to a color
  if (isnil(filter) && isnil(transmit)) return color
  if (islist(color) || isarray(color) || istuple(color)) {
    if (color.count() >= 1 && (isnil(color[0]) || !isnumber(color[0]))) {
      if (isarray(color)) {
        var n = color.count()
        var out[n]
        for (i in 0...n) {
          out[i] = isnil(color[i]) ? nil : withLegacyTransp(color[i], filter, transmit)
        }
        return out
      }
      var out = []
      for (c in color) out.append(isnil(c) ? nil : withLegacyTransp(c, filter, transmit))
      return out
    }
  }
  return withLegacyTransp(color, filter, transmit)
}

fn _unselected(selection, grade, i) { // True if this element is not selected
  return isselection(selection) && !selection.isselected(grade, i)
}

fn _selectedIds(mesh, selection, grade) { // Ids of selected elements of this grade
  var ids = []
  for (i in 0...mesh.count(grade)) {
    if (_unselected(selection, grade, i)) continue
    ids.append(i)
  }
  return ids
}

/* ----------------------------------------------------------------
 * Color coercion
 * ---------------------------------------------------------------- */

fn _isNumericRgb(seq) {
  var n = seq.count()
  if (n != 3 && n != 4) return false
  return isnumber(seq[0]) &&
         isnumber(seq[1]) &&
         isnumber(seq[2]) &&
         (n == 3 || isnumber(seq[3]))
}

fn _isSharedPlotColor(ColorTable color) { return false } // True if every element uses the same color
fn _isSharedPlotColor(color) {
  if (isnil(color)) return true
  if (ismatrix(color)) return false
  if (islist(color) || isarray(color) || istuple(color)) return _isNumericRgb(color)
  return true
}

fn _plotChannels(ColorTable color) { return color.channels() }
fn _plotChannels(Coloring color) { return (color.alpha(0) < 0.999) ? 4 : 3 }
fn _plotChannels(color) {
  if ((islist(color) || istuple(color)) && _isNumericRgb(color) && color.count() == 4) {
    return 4
  }
  return 3
}

fn _plotColorColumn(Coloring color, nch, x) {
  if (nch == 4) {
    var t = color.rgba(x)
    return Matrix([t[0], t[1], t[2], t[3]])
  }
  var t = color.rgb(x)
  return Matrix([t[0], t[1], t[2]])
}
fn _plotColorColumn(Coloring color, nch) { return _plotColorColumn(color, nch, 0) }
fn _plotColorColumn(color, nch) { return _plotColorColumn(asColoring(color), nch) }

fn _presentGrades(mesh, glist) { // Which requested grades actually exist on the mesh
  var out = []
  for (g in glist) {
    if (mesh.count(g) > 0) out.append(g)
  }
  return out
}

fn _plotColorForGrade(grade, color, drawn=nil) { // Color for this grade. If one color is shared, darken points and edges against faces
  var col
  if (isnil(color)) {
    col = Gray(0.5)
  } else if (islist(color) || isarray(color) || istuple(color)) {
    if (_isNumericRgb(color)) {
      col = Color(color)
    } else if (isnil(color[grade])) {
      col = Gray(0.5)
    } else {
      col = color[grade]
    }
  } else {
    col = asColoring(color)
  }

  if (isnil(drawn) || drawn.count() == 0 || !_isSharedPlotColor(color)) return col
  var mx = drawn[0]
  for (g in drawn) if (g > mx) mx = g
  var gap = mx - grade
  if (gap <= 0) return col
  return Darken(asColoring(col), 1 - (2/3)^gap)
}

fn _plotColorForElement(ColorTable color, element) { return color.color(element) }
fn _plotColorForElement(color, element) { return color }

fn _isPerElementColor(ColorTable color, nel) { return color.count() == nel }
fn _isPerElementColor(color, nel) { return false }

/* ----------------------------------------------------------------
 * Selection / field → colors
 * ---------------------------------------------------------------- */

fn _selectionColors(mesh, selection, grade) { // Gray for unselected elements, red for selected
  var ngrades = mesh.maxgrade()
  var col[ngrades+1]

  for (g in 0..ngrades) {
    col[g] = nil
    if (!_wantsGrade(grade, g)) continue

    var selected = selection.idlistforgrade(g)
    if (selected.count() == 0) continue

    var nel = mesh.count(g)
    var cmat = Matrix(3, nel) + 0.5
    for (i in selected) cmat.setColumn(i, Matrix([1, 0, 0]))
    col[g] = ColorTable(cmat)
  }
  return col
}

/* ----------------------------------------------------------------
 * Field value → colormap [0,1]
 * ---------------------------------------------------------------- */

fn _linearNormalize(val, vmin, vmax, center=nil) { // Map a value between vmin and vmax onto [0, 1]
  if (!isnil(center)) {
    if (val >= center) {
      var hi = vmax - center
      if (abs(hi) < 1e-16) return 0.5
      return 0.5 + 0.5*clamp01((val - center)/hi)
    }
    var lo = center - vmin
    if (abs(lo) < 1e-16) return 0.5
    return 0.5*clamp01((val - vmin)/lo)
  }

  var span = vmax - vmin
  if (abs(span) < 1e-16) return 0.5 // uniform field → mid colormap
  return clamp01((val - vmin)/span)
}

fn _fieldSampleNorm(val, vmin, vmax, scale=true, center=nil) { // Scale a field value into [0, 1], or leave it unscaled
  if (!scale) return val
  if (val < vmin) val = vmin
  if (val > vmax) val = vmax
  return _linearNormalize(val, vmin, vmax, center=center)
}

fn _fieldColors(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
                cmin=nil, cmax=nil, center=nil) { // Color each element from its field value
  var mesh = field.mesh()
  var shape = field.shape()
  var sel = selection
  var ngrades = shape.count()
  var showgrades = []
  var col[ngrades+1]

  var cm = colormap
  if (isnil(cm)) cm = ViridisMap()

  var bnd = bounds(field)
  if (!isnil(cmin)) bnd[0] = cmin
  if (!isnil(cmax)) bnd[1] = cmax
  var vmin = bnd[0], vmax = bnd[1]

  if (_styleHas(style, "interpolate")) {
    if (!_wantsGrade(grade, 2)) return (mesh, sel, showgrades, col, cm, bnd)

    var nv = mesh.count(0)
    var nch = _plotChannels(cm)
    var cmat = Matrix(nch, nv)

    if (field.shape()[0] == 0) _PltFldIntErr.throw()

    if (!isnil(sel)) {
      if (sel.count(2) == 0) {
        sel = sel.clone()
        sel.addgrade(2)
      } else if (sel.count(0) == 0) {
        sel = sel.clone()
        sel.addgrade(0)
      }
      if (sel.count(2) == 0 || sel.count(0) == 0) _PltSlctnEmptyErr.throw()
    }

    for (i in 0...nv) {
      if (!isnil(sel) && !sel[0, i]) continue
      var t = _fieldSampleNorm(field[0, i], vmin, vmax, scale=scale, center=center)
      cmat.setColumn(i, _plotColorColumn(cm, nch, t))
    }

    col[2] = ColorTable(cmat)
    showgrades.append(2)
  } else {
    for (g in 0...ngrades) {
      if (shape[g] == 0) continue
      if (!_wantsGrade(grade, g)) continue

      var nel = mesh.count(g)
      var nch = _plotChannels(cm)
      var cmat = Matrix(nch, nel)
      for (i in 0...nel) {
        if (!isnil(sel) && !sel[g, i]) continue
        var t = _fieldSampleNorm(field[g, i], vmin, vmax, scale=scale, center=center)
        cmat.setColumn(i, _plotColorColumn(cm, nch, t))
      }
      col[g] = ColorTable(cmat)
      showgrades.append(g)
    }
  }

  return (mesh, sel, showgrades, col, cm, bnd)
}

/* ----------------------------------------------------------------
 * Presentation helper functions
 * ---------------------------------------------------------------- */

fn _niceTicks(a, b, nmax) { // Tick marks on [a, b], at most nmax of them
  var width = (b - a)
  if (abs(width) < 1e-16) return a..a:1

  var dw = 10^(floor(log10(width/nmax)) - 1)
  while (dw < width) {
    for (x in [dw, 2*dw, 5*dw]) {
      var r = (x*ceil(a/x))..(x*floor(b/x)):x
      if (r.count() <= nmax) return r
    }
    dw *= 10
  }
  return a..b:(b - a)/nmax
}

fn _segmentLine(Matrix p0, Matrix p1, color) { // Line between two points
  var pos = Matrix(3, 2)
  pos.setColumn(0, p0)
  pos.setColumn(1, p1)
  return LineSet(pos, color=color)
}

fn _wirebox(lo, hi, color) { // Wireframe box
  var x0 = lo[0], x1 = hi[0]
  var y0 = lo[1], y1 = hi[1]
  var z0 = lo[2], z1 = hi[2]
  var pos = Matrix([
    [x0, x1, x1, x0, x0, x1, x1, x0],
    [y0, y0, y1, y1, y0, y0, y1, y1],
    [z0, z0, z0, z0, z1, z1, z1, z1]
  ])
  var edges = (
    (0, 1), (1, 2), (2, 3), (3, 0),
    (4, 5), (5, 6), (6, 7), (7, 4),
    (0, 4), (1, 5), (2, 6), (3, 7)
  )
  return LineSet(pos, edges, color=color)
}

fn _domainWire(bnds, color) { // Outline of the plot bounds as a line, rectangle, or box
  var info = _boundsLoHi(bnds)
  var lo = info[0], hi = info[1], dim = info[2]

  if (dim <= 1) return _segmentLine(lo, hi, color)

  if (dim == 2) {
    var x0 = lo[0], x1 = hi[0]
    var y0 = lo[1], y1 = hi[1]
    var z = lo[2]
    return LineSet(Matrix([
      [x0, x1, x1, x0],
      [y0, y0, y1, y1],
      [z, z, z, z]
    ]), ((0, 1), (1, 2), (2, 3), (3, 0)), color=color)
  }

  return _wirebox(lo, hi, color)
}

fn _frameLabels(bnds, size=18, ticksize=12, nticks=5) { // Colored axis lines, names, and numeric ticks
  var info = _boundsLoHi(bnds)
  var lo = info[0], hi = info[1], dim = info[2]
  var g = Graphics()
  if (dim < 1) return g

  var tip = 1.08
  var extent = (hi - lo).norm(Inf)
  if (extent < 1e-12) extent = 1
  var ticklen = 0.06*extent
  var labeloff = 1.8*ticklen
  var tickColor = Color(0.75, 0.75, 0.8)
  var names = ["x", "y", "z"]
  var spineColor = [Red, Green, Blue]

  for (ax in 0...dim) {
    g.display(_segmentLine(_ptOnAxis(lo, ax, lo[ax]), _ptOnAxis(lo, ax, hi[ax]), spineColor[ax]))
    g.display(Text(names[ax], _ptOnAxis(lo, ax, lo[ax] + tip*(hi[ax] - lo[ax])),
                   dirn=[1, 0, 0], vertical=[0, 1, 0], size=size, color=White))
  }

  for (ax in 0...dim) {
    var mark = (ax == 1) ? 0 : 1 // tick into -y for x/z, -x for y
    for (t in _niceTicks(lo[ax], hi[ax], nticks)) {
      var p0 = _ptOnAxis(lo, ax, t)
      var p1 = p0.clone()
      p1[mark] = lo[mark] - ticklen
      g.display(_segmentLine(p0, p1, tickColor))

      var lp = p0.clone()
      lp[mark] = lo[mark] - labeloff
      g.display(Text(Float(t).format("%0.4g"), lp,
                     dirn=[1, 0, 0], vertical=[0, 1, 0], size=ticksize, color=White))
    }
  }

  return g
}

fn _faceEdgeDir(el, a, b) { // +1 if the face goes a then b, -1 if b then a, 0 if that edge is absent
  for (j in 0...3) {
    var u = el[j]
    var v = el[(j == 2) ? 0 : j+1]
    if (u == a && v == b) return 1
    if (u == b && v == a) return -1
  }
  return 0
}

fn _faceOrientation(mesh, vertMat, selection=nil) { // Signs so neighboring faces point the same way
  var nf = mesh.count(2)
  var faces = mesh.connectivitymatrix(0, 2)
  var fnorm = Matrix(3, nf)
  var edgefaces = Dictionary()
  var sign[nf]
  var seen[nf]
  var comp[nf]
  for (i in 0...nf) { sign[i] = 1; seen[i] = false; comp[i] = -1 }

  if (!issparse(faces)) return (fnorm, sign)

  for (i in 0...nf) {
    if (_unselected(selection, 2, i)) continue
    var el = faces.rowindices(i)
    fnorm.setColumn(i, cross3D(vertMat.column(el[1]) - vertMat.column(el[0]),
                               vertMat.column(el[2]) - vertMat.column(el[0])))
    for (e in [[el[0], el[1]], [el[1], el[2]], [el[2], el[0]]]) {
      var a = e[0], b = e[1]
      var k = (a < b) ? "${a}_${b}" : "${b}_${a}"
      if (!edgefaces.contains(k)) edgefaces[k] = []
      edgefaces[k].append(i)
    }
  }

  var neigh[nf]
  for (i in 0...nf) neigh[i] = []
  for (k in edgefaces) {
    var fs = edgefaces[k]
    if (fs.count() != 2) continue
    neigh[fs[0]].append(fs[1])
    neigh[fs[1]].append(fs[0])
  }

  var ncomp = 0
  for (seed in 0...nf) {
    if (seen[seed]) continue
    if (_unselected(selection, 2, seed)) continue
    seen[seed] = true
    sign[seed] = (fnorm.column(seed)[2] < 0) ? -1 : 1
    comp[seed] = ncomp
    var queue = [seed]
    var qi = 0
    while (qi < queue.count()) {
      var f = queue[qi]
      qi += 1
      var elf = faces.rowindices(f)
      for (g in neigh[f]) {
        if (seen[g]) continue
        if (_unselected(selection, 2, g)) continue
        var elg = faces.rowindices(g)
        var flipped = false
        var found = false
        for (j in 0...3) {
          var a = elf[j], b = elf[(j == 2) ? 0 : j+1]
          var dirg = _faceEdgeDir(elg, a, b)
          if (dirg == 0) continue
          found = true
          flipped = (dirg == 1)
          break
        }
        if (!found) continue
        sign[g] = flipped ? -sign[f] : sign[f]
        seen[g] = true
        comp[g] = ncomp
        queue.append(g)
      }
    }
    ncomp += 1
  }

  for (c in 0...ncomp) {
    var closed = true
    for (k in edgefaces) {
      var fs = edgefaces[k]
      var nIn = 0
      for (f in fs) {
        if (comp[f] == c) nIn += 1
      }
      if (nIn != 0 && nIn != 2) { closed = false; break }
    }
    if (!closed) continue
    var vol = 0
    for (i in 0...nf) {
      if (comp[i] != c) continue
      var el = faces.rowindices(i)
      var v0 = vertMat.column(el[0])
      vol += sign[i] * v0.inner(fnorm.column(i))
    }
    if (vol < 0) {
      for (i in 0...nf) {
        if (comp[i] == c) sign[i] = -sign[i]
      }
    }
  }

  return (fnorm, sign)
}

fn _orientedFaceNormalMatrix(mesh, vertMat, selection=nil) { // Face normals after making their directions consistent
  var got = _faceOrientation(mesh, vertMat, selection=selection)
  var fnorm = got[0], sign = got[1]
  var nf = mesh.count(2)
  var out = Matrix(3, nf)
  for (i in 0...nf) out.setColumn(i, sign[i] * fnorm.column(i))
  return out
}

fn _smoothVertexNormals(mesh, vertMat, selection=nil) { // Average neighboring face normals onto vertices
  var nv = mesh.count(0)
  var nf = mesh.count(2)
  var acc = Matrix(3, nv)
  var faces = mesh.connectivitymatrix(0, 2)
  if (!issparse(faces)) return acc

  var got = _faceOrientation(mesh, vertMat, selection=selection)
  var fnorm = got[0], sign = got[1]

  for (i in 0...nf) {
    if (_unselected(selection, 2, i)) continue
    var n = sign[i] * fnorm.column(i)
    var el = faces.rowindices(i)
    for (pidx in el) acc.setColumn(pidx, acc.column(pidx) + n)
  }

  for (i in 0...nv) {
    var n = acc.column(i)
    var len = n.norm()
    if (len > 1e-16) acc.setColumn(i, n/len)
    else acc.setColumn(i, Matrix([0, 0, 1]))
  }
  return acc
}

/* ----------------------------------------------------------------
 * ScaleBar
 * 
 * Visualizes a color map with ticks and labels
 * ---------------------------------------------------------------- */

class ScaleBar {
  _asVec(val, default, unit=false) { // Convert an argument to a 3-vector
    if (isnil(val)) val = default
    var out = (ismatrix(val) || islist(val) || istuple(val)) ? Matrix(val) : nil
    if (isnil(out) || out.count() != 3) _PltSclBrVctrErr.throw()
    if (unit) {
      var n = out.norm()
      if (n < 1e-12) _PltSclBrVctrErr.throw()
      out /= n
    }
    return out
  }

  init(nticks=5, colormap=nil, length=1, posn=nil, dirn=nil, tickdirn=nil,
       textdirn=nil, textvertical=nil, textcolor=nil, fontsize=16) {
    if (!(length > 1e-12)) _PltSclBrVctrErr.throw()
    self.nticks = nticks
    self.length = length
    self.radius = 0.1*length
    self.nptsamples = 5
    self.npts = 16
    self.fontsize = fontsize
    self.colormap = isnil(colormap) ? ViridisMap() : colormap

    var givenTick = !isnil(tickdirn)
    self.posn = self._asVec(posn, [1, 0, 0])
    self.dirn = self._asVec(dirn, [0, 1, 0], unit=true)
    self.tickdirn = self._asVec(tickdirn, [1, 0, 0], unit=true)
    self.tickdirn -= self.tickdirn.inner(self.dirn)*self.dirn
    var tn = self.tickdirn.norm()
    if (tn < 1e-12) {
      if (givenTick) _PltSclBrVctrErr.throw()
      var a = (abs(self.dirn[0]) < 0.9) ? Matrix([1, 0, 0]) : Matrix([0, 1, 0])
      self.tickdirn = cross3D(self.dirn, a)
      tn = self.tickdirn.norm()
    }
    self.tickdirn /= tn
    self.perp = cross3D(self.tickdirn, self.dirn)
    self.textdirn = self._asVec(textdirn, self.tickdirn, unit=true)
    self.textvertical = self._asVec(textvertical, self.dirn, unit=true)
    self.textcolor = textcolor
  }

  ticks(a, b, nmax) { return _niceTicks(a, b, nmax) } // Tick marks on [a, b]

  coords(x, y, z) { // Point on the scale bar given local x, y, z
    return self.posn + x*self.tickdirn + y*self.perp + z*self.dirn
  }

  getFontSize(ticks) { // Font size small enough for the tick spacing
    var ngap = (ticks.count() > 1) ? ticks.count()-1 : 1
    var size = self.fontsize
    if (size/72 > self.length/ngap) size = floor(self.length/ngap*72)
    return size
  }
  getfontsize(ticks) { return self.getFontSize(ticks) } // [Compatibility shim]

  _mesh(section, closed) { // Sweep a 2D cross-section along the bar
    var nsec = section.count()
    var nseg = 2*self.nptsamples
    if (nseg < 1) nseg = 1
    var nslice = nseg + 1, nv = nsec*nslice
    var nt = 2*nseg*(closed ? nsec : nsec-1)
    var L = self.length/2, nch = _plotChannels(self.colormap)
    var pos = Matrix(3, nv), nrm = Matrix(3, nv), col = Matrix(nch, nv)

    for (k in 0...nslice) {
      var z = -L + k*(self.length/nseg)
      var rgb = _plotColorColumn(self.colormap, nch, Float(k)/Float(nseg))
      for (j in 0...nsec) {
        var xy = section[j], x = xy[0], y = xy[1], idx = k*nsec + j
        pos.setColumn(idx, self.coords(x, y, z))
        var n = x*self.tickdirn + y*self.perp, nn = n.norm()
        nrm.setColumn(idx, closed ? ((nn > 1e-12) ? n/nn : self.perp) : self.perp)
        col.setColumn(idx, rgb)
      }
    }

    var conn = Sparse(nv, nt), itri = 0, nj = closed ? nsec : nsec-1
    for (k in 0...nseg) {
      for (j in 0...nj) {
        var jn = (j+1 == nsec) ? 0 : j+1
        var a = k*nsec + j, b = k*nsec + jn, c = (k+1)*nsec + j, d = (k+1)*nsec + jn
        _plotTri(conn, itri, a, c, b); itri += 1
        _plotTri(conn, itri, b, c, d); itri += 1
      }
    }
    return TriangleComplex(pos, nrm, ColorTable(col), conn)
  }

  drawBar() { // Colored cylinder for the color bar
    var r = self.radius, n = self.npts, sec = []
    for (j in 0...n) {
      var th = 2*Pi*j/n
      sec.append((r*cos(th), r*sin(th)))
    }
    var mesh = self._mesh(sec, true)
    var pos = mesh.position, nv = pos.dimensions()[1]
    var lower = pos[0...3, 0...n]
    var upper = pos[0...3, nv-1..nv-n:-1] // reverse last ring → outward +dirn
    var g = Graphics()
    g.display(mesh, flat=true)
    g.display(Polygon(lower, color=self.colormap.color(0)), flat=true)
    g.display(Polygon(upper, color=self.colormap.color(1)), flat=true)
    return g
  }
  drawbar() { return self.drawBar() } // [Compatibility shim]

  drawLabel(min, max) { // Tick marks and numeric labels
    var ticks = self.ticks(min, max, self.nticks)
    var w = max - min, g = Graphics()
    var fsize = self.getFontSize(ticks)
    var toffset = abs(self.dirn.inner(self.textdirn))
    var tvert = sqrt(1 - toffset^2)
    for (t in ticks) {
      var x = (abs(w) < 1e-12) ? 0 : (t - min)/w - 0.5
      var label = Float(t).format("%0.4g")
      var width = (0.6*label.count()*fsize/72)/2, height = fsize/72
      g.display(Cylinder(self.coords(1.2*self.radius, 0, x*self.length),
                         self.coords(1.5*self.radius, 0, x*self.length),
                         aspectratio=0.05, color=White))
      g.display(Text(label,
        self.coords((1.8 + toffset)*self.radius, 0,
                    x*self.length - 0.25*height*tvert - width*toffset),
        size=fsize, dirn=self.textdirn, vertical=self.textvertical, color=self.textcolor))
    }
    return g
  }
  drawlabel(min, max) { return self.drawLabel(min, max) } // [Compatibility shim]

  draw(min, max) { return self.drawBar() + self.drawLabel(min, max) } // Color bar plus labels
}

class ScaleBarStrip is ScaleBar {
  drawBar() {
    var r = self.radius
    var g = Graphics()
    g.display(self._mesh(((-r, 0), (r, 0)), false), flat=true)
    return g
  }
}

/* ----------------------------------------------------------------
 * Plot
 *
 * Visualizes a source object as a Scene
 * ---------------------------------------------------------------- */

class Plot is Scene {
  _setup(source, title=nil, background=nil, axes=false, scalebar=false) { // Set up the Plot from the source object
    super.init(title=title, background=background)
    self.source = source
    self._entries = Dictionary()
    self.bounds = nil
    self.axesBounds = nil
    self.wantAxes = axes
    if (isbool(scalebar)) {
      self.wantScalebar = scalebar
      self.scaleBar = nil
    } else if (isnil(scalebar)) {
      self.wantScalebar = false
      self.scaleBar = nil
    } else {
      self.wantScalebar = true
      self.scaleBar = scalebar
    }
    self.colormap = nil
    self.cmin = nil
    self.cmax = nil
    self.center = nil
    // Field options kept so colormap and range can refresh later
    self.selection = nil
    self.grade = nil
    self.style = nil
    self.scale = true
  }

  _finish() { // Draw axes and scalebar if they were requested
    if (self.wantAxes) self._drawAxes()
    if (self.wantScalebar) self._drawScalebar()
  }

  _recordEntry(role, id) { // Remember this graphics id (points, lines, faces, axes, or scalebar)
    if (isnil(id)) return
    if (!self._entries.contains(role)) self._entries[role] = []
    self._entries[role].append(id)
  }

  _clearRole(role) { // Remove every graphics entry stored under this name
    if (!self._entries.contains(role)) return
    self.beginBatch()
    for (id in self._entries[role]) self.remove(id)
    self.endBatch()
    self._entries.remove(role)
  }

  _drawAxes(nticks=5) { // Draw the bounding-box outline and axis labels
    if (isnil(self.axesBounds)) self.axesBounds = self.bounds
    if (isnil(self.axesBounds)) return
    self.beginBatch()
    self._recordEntry("axes", self.display(_domainWire(self.axesBounds, Color(0.55, 0.55, 0.6))))
    for (id in self.extend(_frameLabels(self.axesBounds, nticks=nticks))) self._recordEntry("axes", id)
    self.endBatch()
  }

  _drawScalebar() { // Draw the colormap legend
    if (self._entries.contains("scalebar")) return
    if (isnil(self.colormap) || isnil(self.cmin) || isnil(self.cmax)) return

    var bar = self.scaleBar
    if (isnil(bar)) {
      var length = 1.0
      var posn = Matrix([1, 0, 0])
      if (!isnil(self.bounds)) {
        var info = _boundsLoHi(self.bounds)
        var lo = info[0], hi = info[1], dim = info[2]
        var sx = hi[0] - lo[0]
        var sy = (dim >= 2) ? (hi[1] - lo[1]) : 1.0
        var sz = (dim >= 3) ? (hi[2] - lo[2]) : 0.0
        var span = abs(sy)
        if (abs(sz) > span) span = abs(sz)
        if (span < 1e-12) span = abs(sx)
        if (span < 1e-12) span = 1.0
        length = span
        var gap = 0.15*((abs(sx) > 1e-12) ? abs(sx) : span)
        posn = Matrix([
          hi[0] + gap,
          (dim >= 2) ? 0.5*(lo[1] + hi[1]) : 0,
          (dim >= 3) ? 0.5*(lo[2] + hi[2]) : 0
        ])
      }
      bar = ScaleBar(length=length, posn=posn, colormap=self.colormap)
    } else {
      bar.colormap = self.colormap
    }
    for (id in self.extend(bar.draw(self.cmin, self.cmax))) self._recordEntry("scalebar", id)
  }

  axes(show) { // Show or hide the bounding-box outline
    if (show) {
      self.wantAxes = true
      if (!self._entries.contains("axes")) self._drawAxes()
    } else {
      self.wantAxes = false
      self._clearRole("axes")
    }
    return true
  }

  scalebar(Bool show) { // Show or hide the colormap legend
    if (show) {
      self.wantScalebar = true
      if (!self._entries.contains("scalebar")) self._drawScalebar()
    } else {
      self.wantScalebar = false
      self._clearRole("scalebar")
    }
    return true
  }
  scalebar(ScaleBar bar) {
    self.wantScalebar = true
    self.scaleBar = bar
    self._clearRole("scalebar")
    self._drawScalebar()
    return true
  }

  _rebuildField() { // Rebuild the field plot from the current source
    if (!isfield(self.source)) return false

    var hadScalebar = self._entries.contains("scalebar") || self.wantScalebar
    var hadAxes = self._entries.contains("axes") || self.wantAxes
    var info = _fieldColors(self.source, selection=self.selection, grade=self.grade,
                            colormap=self.colormap, style=self.style, scale=self.scale,
                            cmin=self.cmin, cmax=self.cmax, center=self.center)
    var mesh = info[0], sel = info[1], showgrades = info[2], col = info[3], cm = info[4], bnd = info[5]
    self.colormap = cm
    self.cmin = bnd[0]
    self.cmax = bnd[1]

    var fast = _styleHas(self.style, "interpolate") &&
        self._entries.contains("faces") && self._entries["faces"].count() == 1 &&
        !self._entries.contains("points") && !self._entries.contains("lines")

    self.beginBatch()

    if (fast) {
      var vertMat = _vertexMatrix3(mesh)
      var bb = _meshBounds(mesh)
      self.bounds = bb
      var planar = _planarAxis(bb)
      var got = self._facesItem(mesh, sel, col,
                                vertMat, bb, planar, style=self.style)
      if (isnil(got) || !self.morph(self._entries["faces"][0], got[0])) {
        self.endBatch()
        return false
      }
    } else {
      self._clearRole("points")
      self._clearRole("lines")
      self._clearRole("faces")
      self._meshInto(mesh, selection=sel, grade=showgrades, color=col,
                     style=self.style)
    }

    if (hadAxes) {
      var expanded = _boundsUnion(self.axesBounds, self.bounds)
      if (!_boundsEqual(self.axesBounds, expanded)) {
        self.axesBounds = expanded
        self._clearRole("axes")
        self._drawAxes()
      }
    }

    if (hadScalebar) {
      self._clearRole("scalebar")
      self._drawScalebar()
    }

    self.endBatch()
    return true
  }

  refresh() { // Rebuild the plot from the current Field
    return self._rebuildField()
  }

  colormap(cm) { // Change the field colormap and rebuild
    if (!isfield(self.source)) return false
    self.colormap = isnil(cm) ? ViridisMap() : cm
    return self._rebuildField()
  }

  range(cmin, cmax) { // Set the displayed field range and rebuild
    if (!isfield(self.source)) return false
    self.cmin = cmin
    self.cmax = cmax
    return self._rebuildField()
  }

  range() { // Use the field's own bounds and rebuild
    if (!isfield(self.source)) return false
    self.cmin = nil
    self.cmax = nil
    return self._rebuildField()
  }

  center(c) { // Set the colormap center and rebuild
    if (!isfield(self.source)) return false
    self.center = c
    return self._rebuildField()
  }

  center() { // Clear the colormap center and rebuild
    if (!isfield(self.source)) return false
    self.center = nil
    return self._rebuildField()
  }

  _pointsInto(mesh, selection, color, style, vertMat, drawn=nil) { // Draw vertices as a PointCloud or as Spheres
    var vcol = _plotColorForGrade(0, color, drawn=drawn)
    var np = mesh.count(0)

    if (_styleHas(style, "spheres") || _styleHas(style, "thick")) {
      for (i in _selectedIds(mesh, selection, 0)) {
        self._recordEntry("points",
          self.display(Sphere(vertMat.column(i), 0.025,
                              color=_plotColorForElement(vcol, i))))
      }
      return
    }

    var ids = _selectedIds(mesh, selection, 0)
    var nshow = ids.count()
    if (nshow == 0) return

    var pos = vertMat[0...3, ids]
    var perVert = _isPerElementColor(vcol, np)
    var pcol = vcol
    var nch = _plotChannels(vcol)
    if (perVert) {
      pcol = Matrix(nch, nshow)
      for (k in 0...nshow) {
        pcol.setColumn(k, _plotColorColumn(_plotColorForElement(vcol, ids[k]), nch))
      }
    }
    self._recordEntry("points",
      self.display(PointCloud(pos, color=perVert ? ColorTable(pcol) : pcol)))
  }

  _linesInto(mesh, selection, color, style, vertMat, drawn=nil) { // Draw edges as a LineSet or as Cylinders
    var lines = mesh.connectivitymatrix(0, 1)
    if (!issparse(lines)) return

    var lcol = _plotColorForGrade(1, color, drawn=drawn)
    var nl = mesh.count(1)

    if (_styleHas(style, "tubes") || _styleHas(style, "thick")) {
      for (i in _selectedIds(mesh, selection, 1)) {
        var el = lines.rowindices(i)
        self._recordEntry("lines",
          self.display(Cylinder(vertMat.column(el[0]), vertMat.column(el[1]),
                                aspectratio=0.025, color=_plotColorForElement(lcol, i))))
      }
      return
    }

    var segs = _selectedIds(mesh, selection, 1)
    var ns = segs.count()
    if (ns == 0) return

    if (_isPerElementColor(lcol, nl)) {
      var nch = _plotChannels(lcol)
      var pos = Matrix(3, 2*ns)
      var ecol = Matrix(nch, 2*ns)
      var edges = []
      for (k in 0...ns) {
        var i = segs[k]
        var el = lines.rowindices(i)
        pos.setColumn(2*k, vertMat.column(el[0]))
        pos.setColumn(2*k + 1, vertMat.column(el[1]))
        var rgb = _plotColorColumn(_plotColorForElement(lcol, i), nch)
        ecol.setColumn(2*k, rgb)
        ecol.setColumn(2*k + 1, rgb)
        edges.append((2*k, 2*k + 1))
      }
      self._recordEntry("lines",
        self.display(LineSet(pos, edges, color=ColorTable(ecol))))
    } else {
      // One color: reuse the mesh vertices
      var edges = []
      for (i in segs) {
        var el = lines.rowindices(i)
        edges.append((el[0], el[1]))
      }
      self._recordEntry("lines",
        self.display(LineSet(vertMat, edges, color=lcol)))
    }
  }

  _facesItem(mesh, selection, color, vertMat, bb, planar, drawn=nil, style=nil) { // Build a TriangleComplex for the faces
    var faces = mesh.connectivitymatrix(0, 2)
    if (!issparse(faces)) return nil

    var fcol = _plotColorForGrade(2, color, drawn=drawn)
    var nf = mesh.count(2)
    var nnt = isselection(selection) ? selection.idlistforgrade(2).count() : nf

    var perFace = _isPerElementColor(fcol, nf)
    var interpolate = _isPerElementColor(fcol, mesh.count(0)) && !perFace

    var wantShade = interpolate || _styleHas(style, "shaded")
    var unlit = !wantShade || (perFace && !interpolate)
    var vnorm = nil
    if (!unlit && isnil(planar)) {
      vnorm = _smoothVertexNormals(mesh, vertMat, selection=selection)
    }

    var perVertex = interpolate || perFace
    var nch = perVertex ? _plotChannels(fcol) : 3
    var nvert = Matrix(3, 3*nnt)
    var norm = Matrix(3, 3*nnt)
    var ncol = perVertex ? Matrix(nch, 3*nnt) : nil
    var tri = Sparse(3*nnt, nnt)

    // Flip the triangle if its vertex order points the wrong way
    var fnorms = (isnil(vnorm) && isnil(planar)) ?
      _orientedFaceNormalMatrix(mesh, vertMat, selection=selection) : nil
    var nnv = 0
    nnt = 0
    for (i in 0...nf) {
      if (_unselected(selection, 2, i)) continue

      var el = faces.rowindices(i)
      var v[3]
      for (pidx, j in el) v[j] = vertMat.column(pidx)

      var authored
      var faceNormal
      if (!isnil(planar)) {
        faceNormal = Matrix(3)
        faceNormal[planar] = 1
        authored = faceNormal
      } else if (!isnil(vnorm)) {
        authored = vnorm.column(el[0]) + vnorm.column(el[1]) + vnorm.column(el[2])
      } else {
        faceNormal = fnorms.column(i)
        authored = faceNormal
      }

      var geom = cross3D(v[1] - v[0], v[2] - v[0])
      var srcj = (geom.inner(authored) < 0) ? [0, 2, 1] : [0, 1, 2]
      var tcol, a = nnv
      if (perVertex && !interpolate) tcol = _plotColorColumn(_plotColorForElement(fcol, i), nch)
      for (j in 0...3) {
        var src = srcj[j]
        nvert.setColumn(nnv, v[src])
        if (!isnil(vnorm)) norm.setColumn(nnv, vnorm.column(el[src]))
        else norm.setColumn(nnv, faceNormal)
        if (perVertex) {
          if (interpolate) tcol = _plotColorColumn(_plotColorForElement(fcol, el[src]), nch)
          ncol.setColumn(nnv, tcol)
        }
        nnv += 1
      }
      _plotTri(tri, nnt, a, a+1, a+2)
      nnt += 1
    }

    return (TriangleComplex(nvert, norm, perVertex ? ColorTable(ncol) : fcol, tri), unlit)
  }

  _facesInto(mesh, selection, color, vertMat, bb, planar, drawn=nil, style=nil) { // Display the faces
    var got = self._facesItem(mesh, selection, color, vertMat, bb, planar,
                             drawn=drawn, style=style)
    if (isnil(got)) return
    self._recordEntry("faces", self.display(got[0], flat=got[1]))
  }

  _meshInto(mesh, selection=nil, grade=nil, color=nil, style=nil) { // Draw the requested mesh grades
    var glist = _gradeList(mesh, grade)
    var drawn = _presentGrades(mesh, glist)
    var vertMat = _vertexMatrix3(mesh)
    var bb = _meshBounds(mesh)
    self.bounds = bb
    var planar = _planarAxis(bb)

    if (_wantsGrade(glist, 0)) {
      self._pointsInto(mesh, selection, color, style, vertMat, drawn=drawn)
    }
    if (_wantsGrade(glist, 1)) {
      self._linesInto(mesh, selection, color, style, vertMat, drawn=drawn)
    }
    if (_wantsGrade(glist, 2)) {
      self._facesInto(mesh, selection, color, vertMat, bb, planar,
                     drawn=drawn, style=style)
    }
  }

  _drawSelection(sel, mesh=nil, grade=nil, color=nil, style=nil) { // Add a selection to the Plot
    var m = isnil(mesh) ? sel.mesh() : mesh
    var col = isnil(color) ? _selectionColors(m, sel, grade) : color
    self._meshInto(m, grade=grade, color=col, style=style)
  }

  _drawField(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
             cmin=nil, cmax=nil, center=nil) { // Add a field to the Plot
    self.selection = selection
    self.grade = grade
    self.style = style
    self.scale = scale

    var info = _fieldColors(field, selection=selection, grade=grade, colormap=colormap,
                            style=style, scale=scale, cmin=cmin, cmax=cmax, center=center)
    var mesh = info[0], sel = info[1], showgrades = info[2], col = info[3], cm = info[4], bnd = info[5]
    self.colormap = cm
    self.cmin = bnd[0]
    self.cmax = bnd[1]
    self.center = center
    self._meshInto(mesh, selection=sel, grade=showgrades, color=col, style=style)
  }

  init(Mesh mesh, selection=nil, grade=nil, color=nil,
       title=nil, background=nil, axes=false, scalebar=false, style=nil) {
    self._setup(mesh, title=title, background=background, axes=axes, scalebar=scalebar)
    self._meshInto(mesh, selection=selection, grade=grade, color=color, style=style)
    self._finish()
  }

  init(Selection sel, mesh=nil, grade=nil, color=nil,
       title=nil, background=nil, axes=false, scalebar=false, style=nil) {
    self._setup(sel, title=title, background=background, axes=axes, scalebar=scalebar)
    self._drawSelection(sel, mesh=mesh, grade=grade, color=color, style=style)
    self._finish()
  }

  init(Field field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
       scalebar=false, cmin=nil, cmax=nil, center=nil,
       title=nil, background=nil, axes=false) {
    self._setup(field, title=title, background=background, axes=axes, scalebar=scalebar)
    self._drawField(field, selection=selection, grade=grade, colormap=colormap, style=style,
                    scale=scale, cmin=cmin, cmax=cmax, center=center)
    self._finish()
  }
}

/* ----------------------------------------------------------------
 * Legacy constructors: Plot of a Mesh, Selection, or Field
 * ---------------------------------------------------------------- */

fn plotmesh(mesh, selection=nil, grade=nil, color=nil, style=nil, filter=nil, transmit=nil) { // Construct a Plot from a Mesh
  return Plot(mesh, selection=selection, grade=grade,
              color=_plotLegacyTransp(color, filter, transmit), // [Compatibility shim]
              style=_legacyStyle(style))
}

fn plotselection(mesh, selection, grade=nil, style=nil, filter=nil, transmit=nil) { // Construct a Plot from a Selection
  var col = nil
  if (!isnil(filter) || !isnil(transmit)) {
    var m = isnil(mesh) ? selection.mesh() : mesh
    col = _plotLegacyTransp(_selectionColors(m, selection, grade), filter, transmit) // [Compatibility shim]
  }
  return Plot(selection, mesh=mesh, grade=grade, style=_legacyStyle(style), color=col)
}

fn plotfield(field, selection=nil, grade=nil, colormap=nil, style=nil, scale=true,
             scalebar=nil, cmin=nil, cmax=nil, center=nil, filter=nil, transmit=nil) { // Construct a Plot from a Field
  var cm = colormap
  if (!isnil(filter) || !isnil(transmit)) {
    cm = _plotLegacyTransp(isnil(cm) ? ViridisMap() : cm, filter, transmit) // [Compatibility shim]
  }
  return Plot(field, selection=selection, grade=grade, colormap=cm,
              style=_legacyStyle(style), scale=scale,
              scalebar=scalebar, cmin=cmin, cmax=cmax, center=center)
}

fn plotaxes(xx0, size=1) { // Red, green, and blue axis arrows
  var x0 = islist(xx0) ? Matrix(xx0) : xx0
  var axes = Graphics()
  axes.display(Arrow(x0, x0 + Matrix([size, 0, 0]), aspectratio=0.05, color=Red))
  axes.display(Arrow(x0, x0 + Matrix([0, size, 0]), aspectratio=0.05, color=Green))
  axes.display(Arrow(x0, x0 + Matrix([0, 0, size]), aspectratio=0.05, color=Blue))
  return axes
}

fn plotmeshlabels(mesh, grade=0, selection=nil, fontsize=10, offset=nil, dirn=nil, vertical=nil, color=nil) { // Label each mesh element with its id
  var gradelist = (islist(grade) || istuple(grade)) ? grade : [grade]
  var gout = Graphics()
  var dir = isnil(dirn) ? [1, 0, 0] : dirn
  var vert = isnil(vertical) ? [0, 1, 0] : vertical

  fn _defaultOffset(x) { return 0.05*(x + Matrix([0.001, 0, 0])) }

  var off = offset
  if (islist(off)) off = Matrix(offset)
  if (isnil(off)) off = _defaultOffset
  var dcol = isnil(color) ? White : color

  for (g in gradelist) {
    var col = dcol
    if (isdictionary(color)) col = color.contains(g) ? color[g] : White

    for (id in 0...mesh.count(g)) {
      if (!isnil(selection) && !selection[g, id]) continue
      var x = _to3D(_centroid(mesh, g, id))
      if (iscallable(dirn)) dir = dirn(x)
      if (iscallable(vertical)) vert = vertical(x)
      var o = iscallable(off) ? off(x) : off
      gout.display(Text("${id}", x + o, size=fontsize, dirn=dir, vertical=vert, color=col))
    }
  }
  return gout
}
