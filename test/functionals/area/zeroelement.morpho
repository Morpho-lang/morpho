import meshtools

var mb = MeshBuilder()
mb.addvertex([0, 0, 0])
mb.addvertex([0, 0, 0])
mb.addvertex([0, 0, 0])
mb.addface([0, 1, 2])
var m = mb.build()

var a = Area()

print a.total(m)
// expect: 0

print a.integrand(m)
// expect: [ 0 ]

print a.gradient(m)
// expect: [ 0 0 0 ]
// expect: [ 0 0 0 ]
// expect: [ 0 0 0 ]
