// Smoke: vector-valued integrate via f(q) fieldgradient (nout = nnodes*ncomp)

import meshtools
import "../functionals/numericalderivatives.morpho"

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))
fn f(x, qv) { return qv.inner(qv) }

var E = AreaIntegral(f, q, method={ "adapt": false })
print (E.fieldgradient(q, m) - numericalfieldgradient(E, m, q)).linearize().norm() < 1e-5
// expect: true

var Ea = AreaIntegral(f, q, method={ })
print (Ea.fieldgradient(q, m) - numericalfieldgradient(Ea, m, q)).linearize().norm() < 1e-4
// expect: true
