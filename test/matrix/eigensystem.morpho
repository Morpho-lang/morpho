// Check eigenvalues works on a problematic matrix

var a = Matrix([[ -0.083929, 0.102945, 0.213477 ],
                [ 0.102945, -0.108697, 0.189335 ],
                [ 0.213477, 0.189335, 0.192626 ]])

var b = a.eigensystem()
print b[0].clss() // expect: @Tuple
print b[1].clss() // expect: @Matrix
