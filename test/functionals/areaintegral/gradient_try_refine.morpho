// Eligible f(x) that fails phase-1 quadrature: shape gradient falls back to local vertex FD

import meshtools
import "../numericalderivatives.morpho"

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([1,1])
mb.addvertex([0,1])
mb.addvertex([0.5,0.5])
mb.addface([0,1,4])
mb.addface([1,2,4])
mb.addface([2,3,4])
mb.addface([3,0,4])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))

var neval = 0
fn peaked(x, qv) {
    neval += 1
    var r2 = (x[0]-0.15)^2 + (x[1]-0.15)^2
    return exp(-250*r2) * x[0] * qv.inner(qv)
}

var E = AreaIntegral(peaked, q, method={ "rule": "tri4", "tol": 1e-10 })
var Eo = AreaIntegral(peaked, q, method={ "rule": "tri4", "tol": 1e-10 }, optimize=false)
E.total(m)
print neval > 19
// expect: true

print (E.gradient(m) - Eo.gradient(m)).norm() < 1e-4
// expect: true
print (E.gradient(m) - numericalgradient(E, m)).norm() < 1e-4
// expect: true
