// Check that node counts are correct for named leaf rules

import meshtools
import "counter.morpho"

var verts = [ nil,
              [ [0], [1] ],
              [ [0,0], [1,0], [0,1] ],
              [ [0,0,0], [1,0,0], [0,1,0], [0,0,1] ] ]
var addel = [ nil,
              fn (mb) mb.addedge([0,1]),
              fn (mb) mb.addface([0,1,2]),
              fn (mb) mb.addvolume([0,1,2,3]) ]

var meshes = [ nil ]
for (g in 1..3) {
    var mb = MeshBuilder()
    for (v in verts[g]) mb.addvertex(v)
    addel[g](mb)
    meshes.append(mb.build())
}

var fns = [ nil, fn (x) 1, fn (x, y) 1, fn (x, y, z) 1 ]
var Integrals = [ nil, LineIntegral, AreaIntegral, VolumeIntegral ]

var tests = [ [ "gauss5", meshes[1], 5 ],
              [ "cubtri7", meshes[2], 7 ],
              [ "cubtri19", meshes[2], 19 ],
              [ "cools16", meshes[2], 16 ],
              [ "tri20", meshes[2], 19 ],
              [ "keast5", meshes[3], 15 ] ]

for (t in tests) {
    var rule = t[0]
    var m = t[1]
    var nexp = t[2]
    var g = m.maxgrade()
    var c = EvaluationCounter(fns[g])
    Integrals[g](c.eval, method={ "rule": rule, "adapt": false }).total(m)
    print c.count() == nexp
}
// expect: true
// expect: true
// expect: true
