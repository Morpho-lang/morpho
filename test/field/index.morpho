// One-index get and set use the lowest nonempty grade

var m = Mesh("square.mesh")
print m
// expect: <Mesh: 4 vertices>

var v = Field(m)
for (i in 0...4) v[i] = i
print v[0]
// expect: 0
print v[3]
// expect: 3

var f = Field(m, grade=2)
f[0] = 10
f[1] = 20
print f[0]
// expect: 10
print f[1]
// expect: 20
print f[2, 0]
// expect: 10
print f[2, 1]
// expect: 20

print f[0, 0]
// expect: Warning 'FldIdxAutoGrd': Field indexed using the form f[0,id], but grade zero is empty. Using the lowest nonempty grade, but recommend using the form f[id] to select the grade automatically.
// expect: 10
print f[0, 0]
// expect: 10
print f[0, 0, 0]
// expect: 10

f[0, 1] = 99
print f[1]
// expect: 99
print f[2, 1]
// expect: 99
