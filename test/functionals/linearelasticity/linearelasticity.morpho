
var m = Mesh("stretchsquare.mesh")
var mshear = Mesh("shearsquare.mesh")
var mscale = Mesh("scalesquare.mesh")
var mref = Mesh("square.mesh")

var e = LinearElasticity(mref)

e.poissonratio = 0.2

print e.reference
// expect: <Mesh: 4 vertices>
print e.grade
// expect: 2

print (e.integrand(m) - Field(m, 0.625, grade=2)).norm() < 1e-5
// expect: true

print e.total(m)
// expect: 1.25

print (e.integrand(mshear) - Field(mshear, 0.0303819, grade=2)).norm() < 1e-5
// expect: true

print (e.integrand(mscale) - Field(mscale, 1.5625, grade=2)).norm() < 1e-5
// expect: true

print e.gradient(mscale)
// expect: [ -2.08333 2.08333 -2.08333 2.08333 ]
// expect: [ -2.08333 -2.08333 2.08333 2.08333 ]
// expect: [ 0 0 0 0 ]
