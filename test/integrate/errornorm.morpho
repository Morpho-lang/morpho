// Check that error-norm contracts meet the accuracy goal on a polynomial
// and on a smooth integrand.

import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()

print abs(AreaIntegral(fn (x) x[0]^2, method={ "errornorm": "max" }).total(m) - 1/12) < 1e-12
print abs(AreaIntegral(fn (x) x[0]^2, method={ "errornorm": "sum" }).total(m) - 1/12) < 1e-12

var ref = 0.031203084128814462056
print abs((AreaIntegral(fn (x) sin(3*x[0]+6*x[1]), method={ }).total(m) - ref)/ref) < 1e-6
print abs((AreaIntegral(fn (x) sin(3*x[0]+6*x[1]), method={ "errornorm": "sum" }).total(m) - ref)/ref) < 1e-6
// expect: true
// expect: true
// expect: true
// expect: true
