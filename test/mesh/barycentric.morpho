var a = Mesh("square.mesh")

print a.barycentric(2, 0, Matrix([0, 0, 0]))
// expect: [ 1 ]
// expect: [ 0 ]
// expect: [ 0 ]

print a.barycentric(2, 0, Matrix([0.25, 0.25, 0]))
// expect: [ 0.5 ]
// expect: [ 0.25 ]
// expect: [ 0.25 ]

print a.barycentric(2, 1, Matrix([0.75, 0.75, 0]))
// expect: [ 0.25 ]
// expect: [ 0.25 ]
// expect: [ 0.5 ]
