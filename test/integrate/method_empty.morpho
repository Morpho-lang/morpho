// Empty method={} is equivalent to omitting method.

import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))
fn f(x, qv) { return qv.inner(qv) }

var E = AreaIntegral(f, q)
var Eempty = AreaIntegral(f, q, method={})

print abs(E.total(m) - Eempty.total(m)) < 1e-14
print (E.gradient(m) - Eempty.gradient(m)).norm() < 1e-14
print (E.fieldgradient(q, m) - Eempty.fieldgradient(q, m)).linearize().norm() < 1e-14

var Eo = AreaIntegral(f, q, optimize=false)
var Eoempty = AreaIntegral(f, q, method={}, optimize=false)

print abs(Eo.total(m) - Eoempty.total(m)) < 1e-14
print (Eo.gradient(m) - Eoempty.gradient(m)).norm() < 1e-14
print (Eo.fieldgradient(q, m) - Eoempty.fieldgradient(q, m)).linearize().norm() < 1e-14
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
