// Set elements of a ComplexMatrix with mixture of Complex and Real args

import newlinalg 

var A = ComplexMatrix(2,2)

// Set using two indices
A[0,0] = 1+im // Make sure imag part is zero'd out
A[0,0] = 1
A[0,1] = 2+2im
A[1,0] = 3.0
A[1,1] = 4+4im

print A
// expect: [ 1 + 0im 2 + 2im ]
// expect: [ 3 + 0im 4 + 4im ]
