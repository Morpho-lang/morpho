// End-to-end Field interpolation for CG3 with reversed edges and a shared face

import meshtools

fn poly2(x, y) { return x^3 + 2*x^2*y + 3*x*y^2 }
fn dpoly2(x, y) {
    return Matrix([3*x^2 + 4*x*y + 3*y^2, 2*x^2 + 6*x*y])
}
fn hpoly2(x, y) {
    return Matrix([[6*x + 4*y, 4*x + 6*y],
                   [4*x + 6*y, 6*x]])
}

fn poly3(x, y, z) { return x^3 + 2*x*y*z + z^3 }
fn dpoly3(x, y, z) { return Matrix([3*x^2 + 2*y*z, 2*x*z, 2*x*y + 3*z^2]) }
fn hpoly3(x, y, z) {
    return Matrix([[6*x, 2*z, 2*y],
                   [2*z, 0, 2*x],
                   [2*y, 2*x, 6*z]])
}

var mb2 = MeshBuilder()
mb2.addvertex([0, 0])
mb2.addvertex([1, 0])
mb2.addvertex([0, 1])
mb2.addvertex([1, 1])
mb2.addface([0, 1, 2])
mb2.addface([1, 3, 2])
var m2 = mb2.build()
m2.addgrade(1)

var fe2 = FiniteElementSpace("CG3", grade=2)
var f2 = Field(m2, poly2, finiteelementspace=fe2)

print abs(f2.evalElement(0, [1/3, 1/3, 1/3]) - poly2(1/3, 1/3)) < 1e-12
// expect: true
var xmid = Matrix([0.5, 0.5])
var l0 = m2.barycentric(2, 0, xmid)
var l1 = m2.barycentric(2, 1, xmid)
print abs(f2.evalElement(0, l0) - poly2(0.5, 0.5)) < 1e-12
// expect: true
print abs(f2.evalElement(1, l1) - poly2(0.5, 0.5)) < 1e-12
// expect: true

var gok = true
var hok = true
fn check2(x, q) {
    if ((grad(q)-dpoly2(x[0], x[1])).norm() > 1e-8) gok = false
    if ((hess(q)-hpoly2(x[0], x[1])).norm() > 1e-8) hok = false
    return 0
}
print AreaIntegral(check2, f2).total(m2)
// expect: 0
print gok
// expect: true
print hok
// expect: true

var mb3 = MeshBuilder()
mb3.addvertex([0, 0, 0])
mb3.addvertex([1, 0, 0])
mb3.addvertex([0, 1, 0])
mb3.addvertex([0, 0, 1])
mb3.addvertex([0, 0, -1])
mb3.addvolume([0, 1, 2, 3])
mb3.addvolume([0, 1, 2, 4])
var m3 = mb3.build()
m3.addgrade(1)
m3.addgrade(2)

var fe3 = FiniteElementSpace("CG3", grade=3)
var f3 = Field(m3, poly3, finiteelementspace=fe3)

var xface = Matrix([1/3, 1/3, 0])
print abs(f3.evalElement(0, m3.barycentric(3, 0, xface)) - f3.evalElement(1, m3.barycentric(3, 1, xface))) < 1e-12
// expect: true
print abs(f3.evalElement(0, m3.barycentric(3, 0, xface)) - poly3(1/3, 1/3, 0)) < 1e-12
// expect: true

var gok3 = true
var hok3 = true
fn check3(x, q) {
    if ((grad(q)-dpoly3(x[0], x[1], x[2])).norm() > 1e-8) gok3 = false
    if ((hess(q)-hpoly3(x[0], x[1], x[2])).norm() > 1e-8) hok3 = false
    return 0
}
print VolumeIntegral(check3, f3).total(m3)
// expect: 0
print gok3
// expect: true
print hok3
// expect: true
