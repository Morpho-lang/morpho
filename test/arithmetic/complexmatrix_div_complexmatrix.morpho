// Divide ComplexMatrix by ComplexMatrix (solve linear system)
import newlinalg 

var A = ComplexMatrix(2,2)
A[0,0]=1
A[0,1]=1-im
A[1,0]=1
A[1,1]=1+1im

var b = ComplexMatrix(2,1)
b[0,0]=1+1im
b[1,0]=2

print b / A
// expect: [ 2 + 1im ]
// expect: [ -0.5 - 0.5im ]

print b 
// expect: [ 1 + 1im ]
// expect: [ 2 + 0im ]