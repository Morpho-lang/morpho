// FiniteElementSpace nodeCoords methods

var l = FiniteElementSpace("CG3", grade=2)

var nodes = l.nodeCoords()

print nodes.dimensions()
// expect: (3, 10)

print (nodes.column(0) - Matrix([1,0,0])).norm() < 1e-12
// expect: true

print (nodes.column(9) - Matrix([1/3,1/3,1/3])).norm() < 1e-12
// expect: true

print (l.nodeCoords(3) - Matrix([2/3,1/3,0])).norm() < 1e-12
// expect: true
