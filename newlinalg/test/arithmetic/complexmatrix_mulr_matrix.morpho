// Multiply two ComplexMatrices
import newlinalg 

var A = ComplexMatrix(((1+1im, 2+2im),(3+3im,4+4im)))
var B = XMatrix(((4,3),(2,1)))

print B * A
// expect: [ 13 + 13im 20 + 20im ]
// expect: [ 5 + 5im 8 + 8im ]

var C = ComplexMatrix([[1+1im],[3+3im]])

print B * C
// expect: [ 13 + 13im ]
// expect: [ 5 + 5im ]
