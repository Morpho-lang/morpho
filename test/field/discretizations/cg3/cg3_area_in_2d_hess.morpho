import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var l = FiniteElementSpace("CG3", grade=2)
var f = Field(m, fn (x,y) x^3 + 2*x^2*y + 3*x*y^2 + 4*y^3, finiteelementspace=l)

var out = true

fn integrand(x, q) {
    var h = hess(q)
    var ex = Matrix([[6*x[0] + 4*x[1], 4*x[0] + 6*x[1]],
                     [4*x[0] + 6*x[1], 6*x[0] + 24*x[1]]])
    if ((h-ex).norm() > 1e-8) out = false
    return 0
}

print AreaIntegral(integrand, f, method={}).total(m)
// expect: 0

print out
// expect: true
