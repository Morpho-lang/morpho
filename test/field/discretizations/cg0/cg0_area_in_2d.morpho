// CG0 FunctionSpace in two dimensions

import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addvertex([1,1])
mb.addface([0,1,2])
mb.addface([1,3,2])
var m = mb.build()
m.addgrade(1)

var l = FiniteElementSpace("CG0", grade=2)
var f = Field(m, fn (x,y) x, finiteelementspace=l)

print f.shape()
// expect: [ 0, 0, 1 ]

print f.elementDofs(0)
// expect: [ (2, 0, 0) ]

print abs(f.evalElement(0, [1,0,0]) - f.evalElement(0, [1/3,1/3,1/3])) < 1e-12
// expect: true

print abs(AreaIntegral(fn (x, q) q, f, method={ }).total(m) - 0.5) < 1e-10
// expect: true

var g = Field(m, fn (x,y) 4, finiteelementspace=l)
print abs(AreaIntegral(fn (x, q) q, g, method={ }).total(m) - 4) < 1e-10
// expect: true
