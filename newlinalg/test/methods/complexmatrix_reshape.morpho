// Reshape ComplexMatrix
import newlinalg 

var A = ComplexMatrix(2,2)
A[0,0]=1+1im
A[1,0]=2+2im
A[0,1]=3+3im
A[1,1]=4+4im
print A 
// expect: [ 1 + 1im 3 + 3im ]
// expect: [ 2 + 2im 4 + 4im ]

A.reshape(4,1)
print A
// expect: [ 1 + 1im ]
// expect: [ 2 + 2im ]
// expect: [ 3 + 3im ]
// expect: [ 4 + 4im ]

