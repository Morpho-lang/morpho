// Neighbor discovery through symmetries: g>0 (LineTorsionSq) and g==0 (LineCurvatureSq).
// Edges are added so an element id is distinct from all of its vertex ids; the old
// reverse-symmetry lookup used the element id in place of vids[k] and missed partners.
import constants
import meshtools
import symmetry

fn helix(t) {
    return [cos(2*Pi*t), sin(2*Pi*t), t]
}

var mb = MeshBuilder()
var ts = [0, 2/3, 4/3, 2]
for (t in ts) mb.addvertex(helix(t))
mb.addedge([2, 3])
mb.addedge([0, 1])
mb.addedge([1, 2])
var m = mb.build()

var s = Selection(m, fn (x, y, z) abs(z)<1e-10 || abs(z-2)<1e-10)
m.addsymmetry(Translate(Matrix([0, 0, 2])), s)
m.addsymmetry(Translate(Matrix([0, 0, -2])), s)

var I = LineTorsionSq().integrand(m)

print I[1] > 1e-8
// expect: true

print I[0] > 1e-8
// expect: true

print abs(I[0]-I[1])/I[1] < 1e-8
// expect: true

print abs(I[1]-I[2])/I[2] < 1e-8
// expect: true

var m0 = LineMesh(fn (t) [t, 0.2*cos(Pi*t), 0], -1..1:0.5)
var s0 = Selection(m0, fn (x, y, z) abs(x+1)<1e-10 || abs(x-1)<1e-10)
m0.addsymmetry(Translate(Matrix([2, 0, 0])), s0)

var C = LineCurvatureSq().integrand(m0)

print C[0] > 1e-8
// expect: true
