// f(q, ∇q) LineIntegral.fieldgradient vs finite-difference of .total

import meshtools
import "../numericalderivatives.morpho"

var m = LineMesh(fn (t) [t, 0, 0], 0..1:0.5)

var P = Field(m, fn (x,y,z) Matrix([x, 0.2, 0]),
              finiteelementspace=FiniteElementSpace("CG1", grade=1))
var phi = Field(m, fn (x,y,z) x,
                finiteelementspace=FiniteElementSpace("CG1", grade=1))

fn gradsqp(x, p) {
    var gp = grad(p)
    return gp[0].norm()^2 + gp[1].norm()^2 + gp[2].norm()^2
}

fn pphicoupling(x, p, ph) {
    var gp = grad(p)
    return ph*(gp[0][0] + gp[1][1] + gp[2][2])
}

var Eg = LineIntegral(gradsqp, P, method={ "adapt": false })
print (Eg.fieldgradient(P, m) - numericalfieldgradient(Eg, m, P)).linearize().norm() < 1e-4
// expect: true

var Ediv = LineIntegral(pphicoupling, P, phi, method={ "adapt": false })
print (Ediv.fieldgradient(P, m) - numericalfieldgradient(Ediv, m, P)).linearize().norm() < 1e-4
// expect: true

print (Ediv.fieldgradient(phi, m) - numericalfieldgradient(Ediv, m, phi)).linearize().norm() < 1e-4
// expect: true

fn qt(x, p) {
    return p.inner(tangent())
}
var Et = LineIntegral(qt, P, method={ "adapt": false })
print (Et.fieldgradient(P, m) - numericalfieldgradient(Et, m, P)).linearize().norm() < 1e-5
// expect: true

