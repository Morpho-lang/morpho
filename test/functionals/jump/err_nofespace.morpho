import meshtools

var mb = MeshBuilder()
mb.addvertex([0, 0, 0])
mb.addvertex([1, 0, 0])
mb.addvertex([0, 1, 0])
mb.addvertex([1, 1, 0])
mb.addface([0, 1, 2])
mb.addface([1, 3, 2])
var m = mb.build()
m.addgrade(1)

var f = Field(m, fn (x, y, z) x*y, finiteelementspace=nil)
print Jump(fn (x, q) jumpdn(q)^2, f).total(m)
// expect error 'FnctlNoFESpc'
