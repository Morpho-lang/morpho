// [CI:Serial]
// Length.gradient assembles unit contributions with a fused multiply-add.
// Split mul-then-add rounds g[0,0] to 0; fma(1/b, b, -1) is -2^(-54).
// Two edges meet at vertex 0, so the result is order-sensitive: -w4 is skipped.

import meshtools

var eps = 2^(-27)
var b = 1-eps

fn vertices(t) {
    if (t==0) return [0, 0]
    if (t==1) return [1, 0]
    return [-b, 0]
}

var m = LineMesh(vertices, 0...3:1, closed=true)
var g = Length().gradient(m)

print g[0,0]
// expect: -5.55112e-17
print g[0,0] == -(2^(-54))
// expect: true
