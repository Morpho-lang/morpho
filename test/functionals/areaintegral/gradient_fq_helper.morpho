// Nested helper that calls grad() must not silently take the f(q) fast path.

import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))

fn helper(qv) {
    var g = grad(qv)
    return g[0].inner(g[0])
}

fn sneaky(x, qv) {
    return helper(qv)
}

var bulk = AreaIntegral(sneaky, q)
print bulk.gradient(m)
// expect error 'IntgrlFstPath'
