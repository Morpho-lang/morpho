// Norm of a ComplexMatrix
import constants

var A = ComplexMatrix(2,2)
A[0,0]=1+im
A[0,1]=2+im
A[1,0]=3-3im
A[1,1]=4-4im

print abs(A.norm(1) - (4*sqrt(2) + sqrt(5))) < 1e-15
// expect: true

print abs(A.norm(Inf) - 7*sqrt(2)) < 1e-15
// expect: true

print abs(A.norm() - sqrt(57)) < 1e-15
// expect: true

print A.norm(5)
// expect error 'LnAlgMtrxNrmArgs'
