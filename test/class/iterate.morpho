// Class implementing the iterate() protocol

class Squares {
    init(max) { self.max = max }

    iterate(i) {
        var sq = i*i
        if (sq <= self.max) return i + 1, sq, i
        return nil, nil, nil
    }

    index(i) {
        var sq = i*i
        if (sq <= self.max) return sq
        return nil
    }
}

{
    var s = Squares(150)
    var i=0, sq

    do {
        (i, sq) = s.iterate(i)
        print (i, sq)
    } while (i)
}
