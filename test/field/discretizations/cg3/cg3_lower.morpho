// CG3 traces onto lower-dimensional spaces, including a reversed shared edge

import meshtools

fn exact2(x, y) { return x^3 + 2*x^2*y + 3*x*y^2 + y^3 }
fn exact3(x, y, z) {
    return x^3 + y^3 + z^3 + 2*x^2*y + 3*x*y*z
}

var mb2 = MeshBuilder()
mb2.addvertex([0, 0])
mb2.addvertex([1, 0])
mb2.addvertex([0, 1])
mb2.addvertex([1, 1])
mb2.addface([0, 1, 2])
mb2.addface([1, 3, 2])
var m2 = mb2.build()
m2.addgrade(1)

var fe2 = FiniteElementSpace("CG3", grade=2)
var f2 = Field(m2, exact2, finiteelementspace=fe2)
var bnd2 = Selection(m2, boundary=true)

print abs(LineIntegral(fn (x, q) (q-exact2(x[0], x[1]))^2, f2).total(m2, bnd2)) < 1e-12
// expect: true

print abs(LineIntegral(fn (x, q) (q-exact2(x[0], x[1]))^2, f2).total(m2)) < 1e-12
// expect: true

var mb3 = MeshBuilder()
mb3.addvertex([0, 0, 0])
mb3.addvertex([1, 0, 0])
mb3.addvertex([0, 1, 0])
mb3.addvertex([0, 0, 1])
mb3.addvolume([0, 1, 2, 3])
var m3 = mb3.build()
m3.addgrade(1)
m3.addgrade(2)

var fe3 = FiniteElementSpace("CG3", grade=3)
var f3 = Field(m3, exact3, finiteelementspace=fe3)
var bnd3 = Selection(m3, boundary=true)

print abs(AreaIntegral(fn (x, q) (q-exact3(x[0], x[1], x[2]))^2, f3).total(m3, bnd3)) < 1e-12
// expect: true
print abs(LineIntegral(fn (x, q) (q-exact3(x[0], x[1], x[2]))^2, f3).total(m3)) < 1e-12
// expect: true

var mbr = MeshBuilder()
mbr.addvertex([0, 0, 0])
mbr.addvertex([1, 0, 0])
mbr.addvertex([0, 1, 0])
mbr.addvertex([0, 0, 1])
mbr.addvertex([0, -1, 0])
mbr.addvolume([0, 1, 2, 3])
mbr.addvolume([1, 0, 4, 3])
var mr = mbr.build()
mr.addgrade(1)
mr.addgrade(2)

var fer = FiniteElementSpace("CG3", grade=3)
var fr = Field(mr, exact3, finiteelementspace=fer)

print abs(LineIntegral(fn (x, q) (q-exact3(x[0], x[1], x[2]))^2, fr).total(mr)) < 1e-12
// expect: true
