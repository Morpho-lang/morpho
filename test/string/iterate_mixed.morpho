// Drive String iteration with a mixture of global and local variables

var str = "Hello!"
var i

{ 
    var v
    for (k in 0..7) {
        (i, v) = str.iterate(k)
        print (i, v)
    }
}
// expect: (1, H)
// expect: (2, e)
// expect: (3, l)
// expect: (4, l)
// expect: (5, o)
// expect: (6, !)
// expect: (nil, nil)
// expect: (nil, nil)
