// End-to-end Field interpolation for representative CG2 spaces

import meshtools

fn poly2(x, y) { return x^2 + x*y + 3*y^2 }
fn dpoly2(x, y) { return Matrix([2*x + y, x + 6*y]) }
fn hpoly2() { return Matrix([[2, 1], [1, 6]]) }

fn poly3(x, y, z) { return x^2 + x*y + 3*y^2 + 2*x*z + 4*y*z + 5*z^2 }
fn dpoly3(x, y, z) { return Matrix([2*x + y + 2*z, x + 6*y + 4*z, 2*x + 4*y + 10*z]) }
fn hpoly3() { return Matrix([[2, 1, 2], [1, 6, 4], [2, 4, 10]]) }

var mb2 = MeshBuilder()
mb2.addvertex([0, 0])
mb2.addvertex([1, 0])
mb2.addvertex([0, 1])
mb2.addface([0, 1, 2])
var m2 = mb2.build()
m2.addgrade(1)

var fe2 = FiniteElementSpace("CG2", grade=2)
var f2 = Field(m2, poly2, finiteelementspace=fe2)

print abs(f2.evalElement(0, [1/3, 1/3, 1/3]) - poly2(1/3, 1/3)) < 1e-12
// expect: true
print abs(f2.evalElement(0, [0.5, 0.3, 0.2]) - poly2(0.3, 0.2)) < 1e-12
// expect: true

var gok = true
fn g2(x, q) {
    if ((grad(q)-dpoly2(x[0], x[1])).norm() > 1e-8) gok = false
    return 0
}
print AreaIntegral(g2, f2).total(m2)
// expect: 0
print gok
// expect: true

var hok = true
fn h2(x, q) {
    if ((hess(q)-hpoly2()).norm() > 1e-8) hok = false
    return 0
}
print AreaIntegral(h2, f2).total(m2)
// expect: 0
print hok
// expect: true

var mb3 = MeshBuilder()
mb3.addvertex([0, 0, 0])
mb3.addvertex([1, 0, 0])
mb3.addvertex([0, 1, 0])
mb3.addvertex([0, 0, 1])
mb3.addvolume([0, 1, 2, 3])
var m3 = mb3.build()
m3.addgrade(1)
m3.addgrade(2)

var fe3 = FiniteElementSpace("CG2", grade=3)
var f3 = Field(m3, poly3, finiteelementspace=fe3)

print abs(f3.evalElement(0, [0.25, 0.25, 0.25, 0.25]) - poly3(0.25, 0.25, 0.25)) < 1e-12
// expect: true
print abs(f3.evalElement(0, [0.4, 0.3, 0.2, 0.1]) - poly3(0.3, 0.2, 0.1)) < 1e-12
// expect: true

var gok3 = true
fn g3(x, q) {
    if ((grad(q)-dpoly3(x[0], x[1], x[2])).norm() > 1e-8) gok3 = false
    return 0
}
print VolumeIntegral(g3, f3).total(m3)
// expect: 0
print gok3
// expect: true

var hok3 = true
fn h3(x, q) {
    if ((hess(q)-hpoly3()).norm() > 1e-8) hok3 = false
    return 0
}
print VolumeIntegral(h3, f3).total(m3)
// expect: 0
print hok3
// expect: true
