// Shape gradient for f(q)-only AreaIntegral vs finite-difference of .total

import meshtools
import "../numericalderivatives.morpho"

var mb = MeshBuilder()
mb.addvertex([0,0])
mb.addvertex([1,0])
mb.addvertex([0,1])
mb.addface([0,1,2])
var m = mb.build()
m.addgrade(1)

var q = Field(m, fn (x,y) Matrix([x, y]))

fn landau(x, qv) {
    var qt2 = qv.inner(qv)
    return qt2 + qt2*qt2
}

var bulk = AreaIntegral(landau, q, method={})
print (bulk.gradient(m) - numericalgradient(bulk, m)).norm() < 1e-5
// expect: true

var bulko = AreaIntegral(landau, q, method={}, optimize=false)
print (bulko.gradient(m) - numericalgradient(bulko, m)).norm() < 1e-5
// expect: true

var bulkold = AreaIntegral(landau, q)
print (bulkold.gradient(m) - numericalgradient(bulkold, m)).norm() < 1e-5
// expect: true

fn usesx(x, qv) {
    return x[0]*qv.inner(qv)
}

var sx = AreaIntegral(usesx, q, method={})
print (sx.gradient(m) - numericalgradient(sx, m)).norm() < 1e-5
// expect: true

fn usesgrad(x, qv) {
    var g = grad(qv)
    return g[0].inner(g[0]) + g[1].inner(g[1])
}

var sg = AreaIntegral(usesgrad, q, method={})
print (sg.gradient(m) - numericalgradient(sg, m)).norm() < 1e-4
// expect: true
