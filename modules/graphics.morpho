/* ***************************************************************
 * Graphics
 * ========
 * Abstract graphics containers
 **************************************************************** */

/* ----------------------------------------------------------------
 * The graphics module provides: 
 * - GraphicsPrimitives : displayable items, e.g. Sphere, Cylinder
 * - Light : Point Lights
 * - GraphicsEntry : An entry in the displaylist with pose info
 * - Graphics : A static container representing a scene
 * - Scene : Live container that can broadcast changes
 * - various utility functions
 * ---------------------------------------------------------------- */

import constants
import color
import broadcast

// Constants
var _LIGHT_MAX = 4 // Viewer applications must support at least this
var _epsNorm = 1e-15   // Used to detect zero norm of a vector
var _epsDraw = 1e-8  // Cutoff 

// Error messages
var _GfxTxtDrnVrtPrllErr = Error("GfxTxtDrnVrtPrll", "Text direction and vertical are either zero length or parallel.")

var _GfxEntryClrErr = Error("GfxEntryClr", "GraphicsEntry.color must be a uniform Coloring.")
var _GfxClrTblLenErr = Error("GfxClrTblLen", "ColorTable must provide one color per vertex.")
var _GfxPolyErr = Error("GfxPoly", "Polygon must be convex and planar n-gon (n>=3).")
var _GfxLightNameErr = Error("GfxLightName", "Graphics.light name must be \"neutral\", \"threepoint\", \"auto\", or \"off\".")
var _GfxLightPosErr = Error("GfxLightPos", "Each lamp must be a 3-vector (Matrix, [x,y,z], or (x,y,z)).")
var _GfxLightNErr = Error("GfxLightN", "Graphics supports up to 4 world-space point lights.")
var _GfxLightValErr = Error("GfxLightVal", "Graphics.light must be nil, a named rig, a Light, a 3-vector, or a list of those.")
var _GfxLightColorErr = Error("GfxLightColor", "Light.color must be a Color.")
var _GfxLineConnErr = Error("GfxLineConn", "LineSet connectivity must contain pairs of valid vertex indices.")

// [Compatibility shim] Warn about use of filter/transmit 
var _GfxLegacyTranspErr = Error("GfxLegacyTransp", "Use of filter and transmit is deprecated. These are now mapped to a Color with alpha. Convert code to use Color(..., a) or Coloring.opacity(a).")
var _warnedLegacyTransp = false

/* ----------------------------------------------------------------
 * 3D geometry utility functions
 * ---------------------------------------------------------------- */

/** 3-vector cross product. `a` and `b` need `[0],[1],[2]` (Matrix, List, or Tuple). */
fn cross3D(a, b) {
  return Matrix([ a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0] ])
}

// Constructs a rotation matrix with angle theta about axis
fn _rotation(theta, axis) {
  var x = axis[0], y=axis[1], z=axis[2]
  var ctheta = cos(theta), stheta = sin(theta), cc=1-ctheta

  return Matrix(
    ( ( x*x*cc+ctheta,   x*y*cc-z*stheta, x*z*cc+y*stheta ),
      ( x*y*cc+z*stheta, y*y*cc+ctheta,   y*z*cc-x*stheta ),
      ( z*x*cc-y*stheta, y*z*cc+x*stheta, z*z*cc+ctheta   ) )
   )
}

/** Generates a vector normal to a given vector but of arbitrary orientation */
fn _normalVector(vec) {
  var order = [abs(vec[0]), abs(vec[1]), abs(vec[2])].order()
  var out=vec.clone()
  out[order[0]]=0
  out[order[1]]=vec[order[2]]
  out[order[2]]=-vec[order[1]]
  return out
}

/** Orthonormalize a set of vectors using Gram-Schmidt */
fn _orthonormalize(m) { 
  var ncols=m.dimensions()[1]
  for (i in 0...ncols) {
    var x = m.column(i)
    for (j in 0...i) {
      var y = m.column(j)
      x -= x.inner(y)*y
    }
    var nrm = x.norm() 
    if (nrm<_epsNorm) return false
    x/=nrm
    m.setcolumn(i, x)
  }
  return true 
}

/** Helper to coerce a List or Matrix to a position 3-vector. */
fn _asPosition(Matrix p) { return p }
fn _asPosition(List p) { return Matrix(p) }
fn _asPosition(Tuple p) { return Matrix(p) }
fn _asPosition(p) { return isnil(p) ? Matrix([0, 0, 0]) : Matrix(p) } 

/** Helper to normalize inputs to a dim x n vertex matrix. */
fn _asVertexMatrix(Matrix pts) { return pts }
fn _asVertexMatrix(List pts) { return Matrix(pts).transpose() }
fn _asVertexMatrix(pts) { return Matrix(pts).transpose() }
fn asVertexMatrix(pts) { return _asVertexMatrix(pts) }

/* ----------------------------------------------------------------
 * [Compatibility shim] Convert legacy transparency model to alpha
 * ---------------------------------------------------------------- */

// Warn on use of legacy interface 
fn _warnLegacyTransp() {
  if (_warnedLegacyTransp) return
  _warnedLegacyTransp = true
  _GfxLegacyTranspErr.warning()
}

// Convert filter/transmit to alpha = 1 − clamp(filter + transmit, 0, 1)
fn _legacyAlpha(filter, transmit) {
  var s = (isnil(filter) ? 0 : filter) + (isnil(transmit) ? 0 : transmit)
  if (s <= 0) return 1
  if (s >= 1) return 0
  return 1 - s
}

// Construct a transparent form of various Coloring objects
fn _opacity(ColorTable color, a) { return color.opacity(a) }
fn _opacity(Color color, a) { return color.opacity(a) }
fn _opacity(Coloring color, a) { return Opacity(color, a) }
fn _opacity(color, a) { return _opacity(asColoring(color), a) }

// Make a color transparent using filter/transmit
fn withLegacyTransp(color, filter, transmit) {
  if (isnil(filter) && isnil(transmit)) return color
  _warnLegacyTransp()
  var a = _legacyAlpha(filter, transmit)
  if (isnil(color)) return Gray(0.5).opacity(a)
  return _opacity(color, a)
}

/* ----------------------------------------------------------------
 * GraphicsPrimitive
 * 
 * Base class for displayable items. 
 * Supports a uniform color. Converts filter/transmit to alpha.
 * ---------------------------------------------------------------- */

class GraphicsPrimitive {
  init(color=nil, filter=nil, transmit=nil) {
    var c = withLegacyTransp(color, filter, transmit)
    self.color = isnil(c) ? Gray(0.5) : asColoring(c)
  }

  // Check that a color setting has the correct number of vertices
  _checkColorCount(col, nv) { }
  _checkColorCount(ColorTable col, nv) {
    if (col.count() != nv) _GfxClrTblLenErr.throw()
  }
}

/* ----------------------------------------------------------------
 * PointCloud
 * 
 * Collection of points, may be individually colored 
 * ---------------------------------------------------------------- */

class PointCloud is GraphicsPrimitive {
  init(position, color=nil) {
    super.init(color=color)
    self.position = _asVertexMatrix(position)
    _checkColorCount(self.color, self.position.dimensions()[1])
  }
}

/* ----------------------------------------------------------------
 * LineSet
 *
 * Represents a collection of line segments.
 *
 * Constructors:
 *   LineSet(position, color=nil, closed=false)
 *       Polyline through successive vertices.
 *
 *   LineSet(position, connectivity, color=nil)
 *       Explicit connectivity, supplied as a List/Tuple of pairs,
 *       or Sparse matrix
 * ---------------------------------------------------------------- */

class LineSet is GraphicsPrimitive {
  _appendSegment(out, seg, nv) { // Validate a segment and append to a list
    if (seg.count() != 2) _GfxLineConnErr.throw()
    var a = seg[0], b = seg[1]
    if (a < 0 || a >= nv || b < 0 || b >= nv) _GfxLineConnErr.throw()
    out.append(a)
    out.append(b)
  }

  _asSegmentIndices(List conn, nv) { // Convert a List of pairs
    var out = []
    for (seg in conn) _appendSegment(out, seg, nv)
    return out
  }

  _asSegmentIndices(Tuple conn, nv) { // Convert a Tuple of pairs
    var out = []
    for (seg in conn) _appendSegment(out, seg, nv)
    return out
  }

  _asSegmentIndices(Sparse conn, nv) { // Convert Sparse connectivity matrix with each column defining one segment
    var out = []
    var nf = conn.dimensions()[1]
    for (i in 0...nf) _appendSegment(out, conn.rowindices(i), nv)
    return out
  }

  _polylineIndices(nv, closed) { // Construct connectivity for a successive polyline
    var out = []
    var nseg = closed ? nv : nv-1

    if (nseg < 1) return out

    for (i in 0...nseg) {
      out.append(i)
      out.append(mod(i+1, nv))
    }

    return out
  }

  _initGeometry(position, connectivity, closed=false) {
    self.position = _asVertexMatrix(position)
    var nv = self.position.dimensions()[1]

    self.connectivity = isnil(connectivity)
        ? _polylineIndices(nv, closed)
        : _asSegmentIndices(connectivity, nv)

    _checkColorCount(self.color, nv)
  }

  init(position, color=nil, closed=false) { // Polyline
    super.init(color=color)
    self._initGeometry(position, nil, closed=closed)
  }

  init(position, connectivity, color=nil) { // Explicit segments
    super.init(color=color)
    self._initGeometry(position, connectivity)
  }
}

/* ----------------------------------------------------------------
 * TriangleComplex
 * 
 * Simplicial complex:
 *   TriangleComplex(position, normals, color, connectivity)
 *   - position : Vertex positions in columns of a Matrix 
 *   - normals : Normal vectors in columns of a Matrix
 *   - color : either a solid color or a ColorTable 
 *   - connectivity : Connectivity matrix; columns correspond to faces
 * ---------------------------------------------------------------- */

class TriangleComplex is GraphicsPrimitive {
  init(position, normals, color, connectivity, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.position = position 
    self.normals = normals 
    self.connectivity = connectivity 
    _checkColorCount(self.color, self.position.dimensions()[1])
  }

  // Helper to extract face i from the corresponding column of a connectivity matrix
  _faceIds(Sparse conn, Int i) { return conn.rowindices(i) }
  _faceIds(Matrix conn, Int i) {
    var ids = [], nv = conn.dimensions()[0]
    for (j in 0...nv) if (conn[j, i] != 0) ids.append(j)
    return ids
  }

  // Obtain vertex ids for face i 
  faceIndices(Int i) { return _faceIds(self.connectivity, i) }
}

/* ----------------------------------------------------------------
 * Text 
 * 
 * Represents text to be displayed. 
 * Constructors:
 *   Text(string, posn)
 *   Text("Hello world", [0,0,0], dirn=[1,0,0], vertical=[0,0,1])
 *   - string : string to display 
 *   - posn : Starting point of text baseline
 *   - dirn : direction of baseline (default [1,0,0])
 *   - vertical : vertical direction of text (default perp to dirn, in the xz plane)
 *   - size, font : control the font
 * ---------------------------------------------------------------- */

class Text is GraphicsPrimitive {
  init(string, posn, dirn=nil, vertical=nil, size=10, font=nil, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.posn = _asPosition(posn)
    self.dirn = isnil(dirn) ? Matrix([1, 0, 0]) : _asPosition(dirn)
    self.vertical = isnil(vertical) ? self._defaultVertical() : _asPosition(vertical)
    if (!_orientationOk()) _GfxTxtDrnVrtPrllErr.throw()
    self.string = string
    self.font = font
    self.size = size
  }

  // Default vertical is perpendicular to dirn but parallel to the xz plane. 
  _defaultVertical() {
    var v = cross3D(self.dirn, Matrix([0, 1, 0]))
    if (v.norm() < _epsNorm) return Matrix([1, 0, 0]) // If dirn is along y, use +x.
    return v
  }

  _orientationOk() {
    if (self.dirn.norm() < _epsNorm || self.vertical.norm() < _epsNorm) return false
    return cross3D(self.vertical, self.dirn).norm() >= _epsNorm
  }

  transformationMatrix() { // dirn, vertical and posn
    var m = Matrix(4,4)
    for (i in 0..3) m[i,i]=1
    for (i in 0..2) {
      m[i,0] = self.dirn[i]
      m[i,1] = self.vertical[i]
    }
    var zp = cross3D(m.column(1), m.column(0))
    for (i in 0..2) m[i,2] = zp[i]
    if (!_orthonormalize(m)) _GfxTxtDrnVrtPrllErr.throw()

    var p = self.posn
    if (!(p[0] == 0 && p[1] == 0 && p[2] == 0)) {
      for (i in 0..2) m[i,3] = p[i]
    }

    return m.transpose()
  }
}

/* ----------------------------------------------------------------
 * TriangleConvertibleMixin 
 * 
 * Mixin to denote primitives that can be reduced to a 
 * TriangleComplex via the protocol:
 * 
 *    toTriangleComplex() -> TriangleComplex
 * ---------------------------------------------------------------- */

var _GfxTriCnvMxnErr = Error("_GfxTriCnvMxn", "GraphicsPrimitive must implement toTriangleComplex().")

class TriangleConvertibleMixin {
  toTriangleComplex() { _GfxTriCnvMxnErr.throw() }
  
    // Construct triangle i with vertex ids (a,b,c) in a connectivity matrix
  _tri(conn, i, a, b, c) {
    conn[a, i] = 1; conn[b, i] = 1; conn[c, i] = 1
    conn.setrowindices(i, (a, b, c))
  }
}

/* ----------------------------------------------------------------
 * Cylinder 
 * 
 * Represents a cylinder as a surface rotated about a line:
 *   Cylinder(start, end, aspectratio=0.1, n=10, color=Red)
 *   - start, end : define the axis
 *   - aspectratio : optional aspect ratio of the cylinder (r/|start - end|)
 *   - radius : optionally specify a radius (overrides aspect ratio)
 *   - n : optional number of segments drawn
 *   - color : optional color
 * ---------------------------------------------------------------- */

class Cylinder is GraphicsPrimitive with TriangleConvertibleMixin {
  init(start, end, aspectratio=0.1, radius=nil, n=10, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.start = _asPosition(start)
    self.end = _asPosition(end)
    self.aspectratio = aspectratio
    self.radius = radius 
    self.n = n
  }

  _radius(length) { // Use provided radius or aspectratio x length
    return self.radius ? self.radius : length*self.aspectratio
  }

  // Geometric parameters for the cylinder
  _lineFrame(unit) {
    if (unit) return self._unitFrame()
    var x1 = self.start, x2 = self.end, dx = x2 - x1, length = dx.norm()
    if (length < _epsDraw) return nil
    var ndx = dx/length, px = _normalVector(dx), pxnorm = px.norm()
    if (pxnorm < _epsNorm) return nil
    return (x1, x2, dx, length, ndx, self._radius(length)*px/pxnorm)
  }

  // Geometric parameters for the unit cylinder (from the origin to z=1 with unit radius)
  _unitFrame() { 
    return (Matrix([0, 0, 0]), Matrix([0, 0, 1]), Matrix([0, 0, 1]),
              1, Matrix([0, 0, 1]), Matrix([1, 0, 0]))
  }

  // Construct an explicit TriangleComplex representing the Cylinder.
  // If unit is true, the cylinder is unit length and unit radius.
  toTriangleComplex(unit=false) {
    var n = self.n, col = self.color
    var np = 2*n+2, nt = 4*n, dim = 3
    var frame = _lineFrame(unit)
    if (isnil(frame)) return nil
    var x1 = frame[0], x2 = frame[1], dx = frame[2], length = frame[3]
    var ndx = frame[4], px = frame[5]
    if (!unit) dim = x1.count()
    var vertices = Matrix(dim, np), normals = Matrix(dim, np)

    // Cap centers + outward unit normals. Ring verts are shared with the sidewall

    vertices.setcolumn(0, x1)    // Cap center at x1
    vertices.setcolumn(np-1, x2) // Cap center at x2 
    normals.setcolumn(0, -ndx)
    normals.setcolumn(np-1, ndx)

    /* Vertices are ordered like this:

           [n+1...2n]
                      \
    [1..n] A------------B
           |            |
           0            1 2n+1
           <---- dx ----> */
    // Ring vertices are shared with the sidewall and therefore carry radial normals.
    if (unit) {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n, qx = Matrix([cos(theta), sin(theta), 0])
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+dx)
        normals.setcolumn(i, qx)
        normals.setcolumn(n+i, qx)
      }
    } else {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n, qx = _rotation(theta, ndx)*px, nn = qx/qx.norm()
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+dx)
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
      }
    }

    var conn = Sparse(np, nt)
    for (i in 0...n) {
      var i2 = (i < n-1) ? i+2 : 1, ni2 = (i < n-1) ? n+i+2 : n+1
      _tri(conn, i, 0, i2, i+1)                 // 0-A cap (outward -Z)
      _tri(conn, n+i, np-1, n+i+1, ni2)         // B-1 cap
      _tri(conn, 2*n+i, i+1, i2, n+i+1)         // A-B sidewall
      _tri(conn, 3*n+i, i2, ni2, n+i+1)
    }

    return TriangleComplex(vertices, normals, col, conn)
  }

}

/* ----------------------------------------------------------------
 * Arrow
 *
 * Represents an arrow from tail `start` to tip `end`.
 *   Arrow(start, end, aspectratio=0.1, radius=nil, n=10, color=Red)
 *   - start, end : tail and tip positions
 *   - aspectratio : head length as a fraction of |end - start|;
 *       if radius is omitted, also sets shaft radius = aspectratio × length
 *   - radius : optional shaft radius; when set, aspectratio still controls
 *       only the head proportions
 *   - n, color : as Cylinder
 * ---------------------------------------------------------------- */

class Arrow is Cylinder {
  toTriangleComplex(unit=false) {
    var aspectratio = self.aspectratio, n = self.n, col = self.color
    /* The arrow is structured like so:

           [n+1...2n]   C--[2n+1...3n]
                      \ |\
    [1..n] A------------B \
           |               \
           0<----- u --->   1 3n+1
           <------ dx ------> */
    var nCore = 3*n+2, np = nCore + 6*n, nt = 6*n, dim = 3
    var frame = _lineFrame(unit)
    if (isnil(frame)) return nil
    var x1 = frame[0], x2 = frame[1], dx = frame[2], length = frame[3]
    var ndx = frame[4], px = frame[5]
    if (!unit) dim = x1.count()
    var vertices = Matrix(dim, np), normals = Matrix(dim, np)

    vertices.setcolumn(0, x1)
    vertices.setcolumn(nCore-1, x2)
    normals.setcolumn(0, -ndx)
    normals.setcolumn(nCore-1, ndx)

    var u = (1-aspectratio)*dx
    if (unit) {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n, qx = Matrix([cos(theta), sin(theta), 0])
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+u)
        vertices.setcolumn(2*n+i, pt+u+qx)
        normals.setcolumn(i, qx)
        normals.setcolumn(n+i, qx)
        normals.setcolumn(2*n+i, qx)
      }
    } else {
      for (i in 1..n) {
        var theta = 2*Pi*(i-1)/n, qx = _rotation(theta, ndx)*px, nn = qx/qx.norm()
        var pt = qx+x1
        vertices.setcolumn(i, pt)
        vertices.setcolumn(n+i, pt+u)
        vertices.setcolumn(2*n+i, pt+u+qx)
        normals.setcolumn(i, nn)
        normals.setcolumn(n+i, nn)
        normals.setcolumn(2*n+i, nn)
      }
    }

    var nAnn = -ndx
    var conn = Sparse(np, nt)
    for (i in 0...n) {
      var i2 = (i < n-1) ? i+2 : 1, ni2 = (i < n-1) ? n+i+2 : n+1
      var ci2 = (i < n-1) ? 2*n+i+2 : 2*n+1
      _tri(conn, i, 0, i2, i+1)                       // 0-A cap (outward -Z)
      _tri(conn, n+i, nCore-1, 2*n+i+1, ci2)          // C-1 tip
      _tri(conn, 2*n+i, i+1, i2, n+i+1)               // A-B sidewall
      _tri(conn, 3*n+i, i2, ni2, n+i+1)
      // B-C annulus: 3 consecutive ids per tri so sorted order is -shaft.
      var b = nCore + 6*i
      vertices.setcolumn(b, vertices.column(n+i+1))
      vertices.setcolumn(b+1, vertices.column(ni2))
      vertices.setcolumn(b+2, vertices.column(2*n+i+1))
      vertices.setcolumn(b+3, vertices.column(ni2))
      vertices.setcolumn(b+4, vertices.column(ci2))
      vertices.setcolumn(b+5, vertices.column(2*n+i+1))
      for (k in 0...6) normals.setcolumn(b+k, nAnn)
      _tri(conn, 4*n+i, b, b+1, b+2)
      _tri(conn, 5*n+i, b+3, b+4, b+5)
    }

    return TriangleComplex(vertices, normals, col, conn)
  }
}

/* ----------------------------------------------------------------
 * Sphere
 * 
 * Represents a spherical shell of radius r about a center
 * ---------------------------------------------------------------- */

var _sphereCache = Dictionary() // Cache unit spheres by level -> (verts, faces)

class Sphere is GraphicsPrimitive with TriangleConvertibleMixin {
  init(center, r, color=nil, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.center = _asPosition(center)
    self.r = r
  }

  // Compute vertex index given azimuthal and polar indices i, j
  _sphereIx(i, j, st, sl, nv) {
    if (i == 0) return 0 // top pole
    if (i == st) return nv - 1 // bottom pole
    return 1 + (i - 1) * sl + j // ring i in 1...st−1, slot j
  }

  _uvSphere(level) {
    if (_sphereCache.contains(level)) return _sphereCache[level]
    var st = 6 + 4 * level, sl = 10 + 6 * level, nv = 2 + (st - 1) * sl
    var v = Matrix(3, nv), tris = []
    var dphi = Pi / st, dth = 2 * Pi / sl
    for (phi, i in 0..Pi:dphi) {
      var sp = sin(phi), cp = cos(phi)
      for (th, j in 0..(2 * Pi - dth):dth) {
        if (i == 0 || i == st) {
          if (j == 0) v.setcolumn(_sphereIx(i, j, st, sl, nv), Matrix([0, 0, cp]))
        } else {
          v.setcolumn(_sphereIx(i, j, st, sl, nv), Matrix([sp * cos(th), sp * sin(th), cp]))
        }
        if (i < st) {
          var jn = mod(j + 1, sl)
          var a = _sphereIx(i, j, st, sl, nv), b = _sphereIx(i, jn, st, sl, nv)
          var c = _sphereIx(i + 1, j, st, sl, nv), d = _sphereIx(i + 1, jn, st, sl, nv)
          if (a == b || c == d) tris.append(a == b ? (a, c, d) : (a, c, b))
          else { tris.append((a, c, b)); tris.append((b, c, d)) }
        }
      }
    }
    var f = Sparse(nv, tris.count())
    for (tri, i in tris) { for (p in tri) f[p, i] = 1 }
    for (tri, i in tris) f.setrowindices(i, tri)
    _sphereCache[level] = (v, f)
    return _sphereCache[level]
  }

  // unit true → unit ball at origin. level is the requested tessellation.
  toTriangleComplex(unit=false, level=3) {
    var col = self.color
    var mesh = _uvSphere(level)
    var uv = mesh[0], v = uv.clone(), nv = v.dimensions()[1]
    var x0 = unit ? Matrix([0, 0, 0]) : self.center
    var r = unit ? 1 : self.r
    for (i in 0...nv) v.setcolumn(i, x0 + r * uv.column(i))
    return TriangleComplex(v, uv.clone(), col, mesh[1].clone())
  }
}

/* ----------------------------------------------------------------
 * Tube
 * 
 * Represents tubes drawn around a sequence of points joined by
 * line segments.
 * Constructor:
 *   Tube(pts, rad, n=10, closed=false)
 *   Tube([x0,x1,x2], 0.1)
 * - pts : The set of points to use
 * - rad : Radius of the tube
 * - n : Number of faces to use per point
 * - closed : whether the path closes (default false)
 * ---------------------------------------------------------------- */

class Tube is GraphicsPrimitive with TriangleConvertibleMixin {
  init(pts, rad, n=10, color=nil, closed=false, filter=nil, transmit=nil) {
    super.init(color=color, filter=filter, transmit=transmit) // [Compatibility shim]
    self.pts = pts
    self.radius = rad
    self.n = n
    self.closed = closed
  }

  toTriangleComplex() {
    var n = self.n, col = self.color, mat = _asVertexMatrix(self.pts)
    var np = mat.dimensions()[1]
    if (np < 2) return nil
    var dim = mat.dimensions()[0], nv = n*np, nt = n*(2*(np-1))
    if (self.closed) nt += 2*n
    else { nv += 2; nt += 2*n }

    var vertices = Matrix(dim, nv), normals = Matrix(dim, nv)
    var sep[np], ndx[np]

    // Separation vectors along the polyline
    for (k in 0..np-2) {
      var dx = mat.column(k+1)-mat.column(k), dlen = dx.norm()
      if (!(dlen > _epsDraw)) return nil
      sep[k] = dx/dlen
      ndx[k] += sep[k]
      ndx[k+1] += sep[k]
    }

    if (self.closed) {
      var dx = mat.column(0)-mat.column(np-1), dlen = dx.norm()
      if (!(dlen > _epsDraw)) return nil
      sep[np-1] = dx/dlen
      ndx[np-1] += sep[np-1]
      ndx[0] += sep[np-1]
    }

    // Vertex rings (axis must be unit for _rotation)
    for (k in 0...np) {
      var px
      if (k == 0) {
        px = _normalVector(ndx[k])
      } else {
        var dx = vertices.column((k-1)*n)-mat.column(k-1)
        px = dx-dx.inner(ndx[k])*ndx[k]/ndx[k].norm()
      }
      px = self.radius*px/px.norm()

      var x1 = mat.column(k), an = ndx[k].norm()
      if (!(an > _epsNorm)) return nil
      var axis = ndx[k]/an
      for (i in 0...n) {
        var theta = i*2*Pi/n, qx = _rotation(theta, axis)*px
        vertices.setcolumn(k*n+i, x1+qx)
        normals.setcolumn(k*n+i, qx/qx.norm())
      }
    }

    var conn = Sparse(nv, nt), m = 0
    for (k in 0..np-2) {
      for (i in 0...n) {
        var a = k*n+i, b = (i == n-1) ? k*n : k*n+i+1, c = (k+1)*n+i
        var d = (i == n-1) ? (k+1)*n : (k+1)*n+i+1
        _tri(conn, m, a, b, c); m += 1
        _tri(conn, m, b, d, c); m += 1
      }
    }

    if (self.closed) {
      var k = np-1
      for (i in 0...n) {
        var a = k*n+i, b = (i == n-1) ? k*n : k*n+i+1
        var c = i, d = (i == n-1) ? 0 : i+1
        _tri(conn, m, a, b, c); m += 1
        _tri(conn, m, b, d, c); m += 1
      }
    } else {
      vertices.setcolumn(nv-2, mat.column(0))
      vertices.setcolumn(nv-1, mat.column(np-1))
      normals.setcolumn(nv-2, -sep[0])
      normals.setcolumn(nv-1, sep[np-2])

      for (i in 0...n) {
        var b = (i == n-1) ? 0 : i+1
        var d = (i == n-1) ? (np-1)*n : (np-1)*n+i+1
        _tri(conn, m, i, nv-2, b); m += 1
        _tri(conn, m, (np-1)*n+i, d, nv-1); m += 1
      }
    }

    return TriangleComplex(vertices, normals, col, conn)
  }

}

/* ----------------------------------------------------------------
 * Polygon
 * 
 * Represents a convex planar polygon. Vertex winding defines the 
 * normal. 
 * ---------------------------------------------------------------- */

class Polygon is GraphicsPrimitive with TriangleConvertibleMixin {
  init(position, color=nil) {
    super.init(color=color)
    self.position = _asVertexMatrix(position)
    _checkColorCount(self.color, self.position.dimensions()[1])
    self._validate()
  }

  /** Unit geometric normal from winding of the first triangle. */
  normal() {
    var p = self.position
    var n = cross3D(p.column(1)-p.column(0), p.column(2)-p.column(0))
    var nn = n.norm()
    if (nn < _epsNorm) _GfxPolyErr.throw()
    return n/nn
  }

  _validate() {
    var p = self.position, d = p.dimensions()
    var nv = d[1]
    if (d[0] != 3 || nv < 3) _GfxPolyErr.throw()

    var n = self.normal()
    var scale = (p.column(1)-p.column(0)).norm()
    var eps = max(1e-8, 1e-6*scale)

    for (i in 3...nv) {
      if (abs((p.column(i)-p.column(0)).inner(n)) > eps)
        _GfxPolyErr.throw()
    }

    for (i in 0...nv) {
      var a = p.column(i)
      var b = p.column(mod(i+1, nv))
      var c = p.column(mod(i+2, nv))
      if (cross3D(b-a, c-b).inner(n) < -eps)
        _GfxPolyErr.throw()
    }
  }

  toTriangleComplex() { // Produce a fan of triangles
    var nv = self.position.dimensions()[1]
    var n = self.normal()
    var normals = Matrix(3, nv)
    for (i in 0...nv) normals.setcolumn(i, n)

    var conn = Sparse(nv, nv-2)
    for (i in 0...nv-2) _tri(conn, i, 0, i+1, i+2)

    return TriangleComplex(self.position, normals, self.color, conn)
  }
}

/* ----------------------------------------------------------------
 * Light
 * 
 * World-space point lamp. 
 * Constructors: 
 *   Light([1,0,0], color=Red)
 *   Light([-1,0,0], intensity=0.2)
 *   - position : location of point source
 *   - color : color of the lamp
 *   - intensity : relative intensity
 * ---------------------------------------------------------------- */

class Light {
  init(position, color=nil, intensity=1) {
    self.position = self._asLightPosition(position)
    self.color = self._asLightColor(color)
    self.intensity = intensity
  }

  clone() {
    return Light(self.position.clone(), color=self.color, intensity=self.intensity)
  }

  _asLightPosition(p) { // Ensure a supplied Light position is a 3-vector
    var m = _asPosition(p)
    if (m.count() != 3) _GfxLightPosErr.throw()
    return m
  }

  // Ensure a supplied Light color is a solid color
  _asLightColor(Color c) { return Color(c.r, c.g, c.b) }
  _asLightColor(Coloring c) { _GfxLightColorErr.throw() }
  _asLightColor(Nil c) { return White }
  _asLightColor(c) { return _asLightColor(asColoring(c)) }
}

/* ----------------------------------------------------------------
 * Lighting
 *
 * Canonicalized lighting configuration for a Graphics object.
 *
 * Constructors:
 *   Lighting()                        Neutral (also nil or [])
 *   Lighting("neutral")               or "threepoint" or "off"
 *   Lighting(Light(...))
 *   Lighting([x,y,z])                 one point light
 *   Lighting([Light(...), ...])       collection of point lights
 *   Lighting([[x,y,z], ...])          collection of point lights
 *
 * "auto" is accepted as an alias for "neutral".
 * ---------------------------------------------------------------- */

var _validUserLightingModes = ["auto", "neutral", "threepoint", "off"]

class Lighting {
  init() { self._setMode("neutral") } // Default 
  init(Nil val) { self._setMode("neutral") }

  init(String mode) { self._setMode(mode) }

  init(Lighting lighting) {
    self.mode = lighting.mode
    self.lights = []
    for (light in lighting.lights) self.lights.append(light.clone())
  }

  init(Light light) {
    self._setCustom()
    self._appendLight(light)
  }

  init(Matrix position) {
    self._setCustom()
    self._appendLight(position)
  }

  init(List lights) {
    self._initSequence(lights)
  }

  init(Tuple lights) {
    self._initSequence(lights)
  }

  init(val) {
    _GfxLightValErr.throw()
  }

  _setMode(mode) {
    if (!_validUserLightingModes.contains(mode)) _GfxLightNameErr.throw()
    if (mode == "auto") mode = "neutral"

    self.mode = mode
    self.lights = []
  }

  _setCustom() {
    self.mode = "custom"
    self.lights = []
  }

  // A sequence of numbers is one position; otherwise a sequence of lamps.
  _initSequence(seq) {
    if (seq.count() == 0) {
      self._setMode("neutral")
      return
    }

    self._setCustom()

    if (isnumber(seq[0])) { // List was just a single light in [x,y,z] form
      self._appendLight(seq)
      return
    }

    for (light in seq) self._appendLight(light)
  }

  _appendLight(Light light) {
    if (self.lights.count() >= _LIGHT_MAX) _GfxLightNErr.throw()
    self.lights.append(light.clone())
  }

  _appendLight(position) {
    self._appendLight(Light(position))
  }

  addLight(Light light) { // Adding an explicit light replaces any named rig.
    if (self.mode != "custom") self._setCustom()
    self._appendLight(light)
    return self
  }

  addLight(position, color=nil, intensity=1) {
    return self.addLight(Light(position, color=color, intensity=intensity))
  }

  clone() { return Lighting(self) }
}

/* ----------------------------------------------------------------
 * GraphicsEntry
 * 
 * Displaylist entry incorporating a stable id, the item to display
 * and transformation information from model to world coordinates.
 * Optional color override. flat is nil (renderer default), true (unlit),
 * or false (shaded).
 * ---------------------------------------------------------------- */

class GraphicsEntry {
  init(id, item, position=nil, scale=nil, rotate=nil, color=nil, flat=nil) {
    self.id = id
    self.item = item
    self.position = _asPosition(position)
    self.scale = self._asScale(scale)
    self.rotate = rotate
    self.color = self._asEntryColor(color)
    self.flat = flat // Rendering-mode override; nil means renderer default
  }

  // Visible coloring: entry override if set, else the primitive's intrinsic color.
  effectiveColor() { return isnil(self.color) ? self.item.color : self.color }

  // Construct rotation matrix for this entry
  rotationMatrix() {
    var r = self.rotate
    if (isnil(r) || abs(r[0]) < _epsDraw) return nil
    return _rotation(r[0], [r[1], r[2], r[3]])
  }

  /** Helpers to coerce a List or Matrix to a scale Matrix. */
  _asScale(Matrix s) { return s }
  _asScale(List s) { return Matrix(s) }
  _asScale(Tuple s) { return Matrix(s) }
  _asScale(s) { return isnil(s) ? 1 : s }

  // Entry color is a uniform presentation override.
  _asEntryColor(Coloring c) { return c }
  _asEntryColor(ColorTable c) { // Reject ColorTable
    _GfxEntryClrErr.throw()
    return nil
  }
  _asEntryColor(c) { // Otherwise construct using asColoring
    if (isnil(c)) return nil
    return _asEntryColor(asColoring(c))
  }
}

/* ----------------------------------------------------------------
 * Graphics
 * 
 * Static displaylist container. Interface:
 *   findEntry - finds an entry from an id 
 *   display(item) - adds a GraphicsPrimitive to the displaylist
 *   display(item, posn) - adds a GraphicsPrimitive with posn 
 *   extend(Graphics) - append another Graphics in place; returns new ids
 *   setLights - sets the lighting
 *   addLight - adds a Light
 *   resetLights - resets 
 * ---------------------------------------------------------------- */

class Graphics {
  init(title = nil, background = nil, light = nil) {
    self.displaylist = [] // GraphicsEntry list
    self._entryById = Dictionary() 
    self._nextId = 1
    self.title = title
    if (!self.title) self.title="Morpho" // Title to show
    self.background = isnil(background) ? Black : asColoring(background)
    if (isnil(self.background)) self.background = Black
    self.light = Lighting(light)
  }

  // Look up an entry by its id 
  findEntry(id) { return self._entryById.contains(id) ? self._entryById[id] : nil }

  // Appends an item to the displaylist, allocating and returning an id 
  _append(item, position=nil, scale=nil, rotate=nil, color=nil, flat=nil) {
    var id = self._nextId
    self._nextId += 1
    var e = GraphicsEntry(id, item, position=position, scale=scale, rotate=rotate,
                          color=color, flat=flat)
    self.displaylist.append(e)
    self._entryById[id] = e
    return id
  }

  // Copy this displaylist into a target
  _copyEntriesInto(g) {
    for (el in self.displaylist) {
      var e = GraphicsEntry(el.id, el.item, position=el.position, scale=el.scale,
                            rotate=el.rotate, color=el.color, flat=el.flat)
      g.displaylist.append(e)
      g._entryById[e.id] = e
    }
  }

  // Left-hand ids kept; right-hand entries remapped onto g
  _joinInto(g, Graphics right) {
    g._nextId = self._nextId
    self._copyEntriesInto(g)
    for (el in right.displaylist) {
      g._append(el.item, position=el.position, scale=el.scale, rotate=el.rotate,
                color=el.color, flat=el.flat)
    }
  }

  /** Append a GraphicsPrimitive (identity SRT). Returns Graphics-owned id. */
  display(GraphicsPrimitive item, color=nil, flat=nil) {
    return self._append(item, color=color, flat=flat)
  }

  /** GraphicsPrimitive with pose: 2nd positional position + scale=/rotate=/color=/flat=. */
  display(GraphicsPrimitive item, position, scale=nil, rotate=nil, color=nil, flat=nil) {
    return self._append(item, position=position, scale=scale, rotate=rotate,
                        color=color, flat=flat)
  }

  setLights(lights) { // Replace lights
    self.light = Lighting(lights)
    return true
  }

  addLight(Light light) {
    self.light.addLight(light)
    return true
  }

  addLight(position, color=nil, intensity=1) {
    return self.addLight(Light(position, color=color, intensity=intensity))
  }

  resetLights() { // Restore neutral lighting
    return self.setLights([])
  }

  // Copy metadata to a target object
  _copyMetaInto(target) {
    target.title = self.title
    target.background = self.background
    target.light = self.light.clone()
  }

  // Combine two Graphics; right hand side is copied into the displaylist with new ids
  add(Graphics right) {
    var g = Graphics()
    self._copyMetaInto(g)
    self._joinInto(g, right)
    return g
  }

  // Append another Graphics in place; returns the new ids
  extend(Graphics right) {
    var ids = []
    for (el in right.displaylist) {
      ids.append(self._append(el.item, position=el.position, scale=el.scale,
                              rotate=el.rotate, color=el.color, flat=el.flat))
    }
    return ids
  }
}

/* ----------------------------------------------------------------
 * GraphicsEvent
 * 
 * Class defining events that may be sent by Scene. Subclasses
 * enable Listeners to process them using multiple dispatch.
 * ---------------------------------------------------------------- */

class GraphicsEvent with BroadcastEvent {
  init(id) { self.id = id } // Retain the event id
}

// Coalesce same-type events across ids to reduce viewer traffic.
fn _coalesceIds(into, prev) {
  if (isnil(prev._seen)) { // Lazily create _seen Dictionary
    prev._seen = Dictionary()
    for (id in prev.ids) prev._seen[id] = true
  }
  for (id in into.ids) {
    if (!prev._seen.contains(id)) {
      prev._seen[id] = true
      prev.ids.append(id)
    }
  }
  into.ids = prev.ids // into must inherit accumulated state
  into._seen = prev._seen
}

// Merge morph events, keeping the earliest old item and latest new item
fn _coalesceMorphed(into, prev) {
  if (isnil(prev._seen)) {
    prev._seen = Dictionary()
    for (id in prev.ids) prev._seen[id] = true
  }
  for (id in into.ids) {
    if (prev._seen.contains(id)) {
      prev.newItems[id] = into.newItems[id]
    } else {
      prev._seen[id] = true
      prev.ids.append(id)
      prev.oldItems[id] = into.oldItems[id]
      prev.newItems[id] = into.newItems[id]
    }
  }
  into.ids = prev.ids
  into.oldItems = prev.oldItems
  into.newItems = prev.newItems
  into._seen = prev._seen
}

// Sent when a new id is defined
class GraphicsEventDefined is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil
  }
  batchKey() { return GraphicsEventDefined }
  coalesce(prev) { _coalesceIds(self, prev) }
}

// Sent when an entry is moved 
class GraphicsEventMoved is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil // filled on first coalesce
  }
  batchKey() { return GraphicsEventMoved }
  coalesce(prev) { _coalesceIds(self, prev) }
}

// Sent when an entry is recolored
class GraphicsEventRecolored is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil
  }
  batchKey() { return GraphicsEventRecolored }
  coalesce(prev) { _coalesceIds(self, prev) }
}

// Sent when an entry is removed from the scene
class GraphicsEventRemoved is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil
  }
  batchKey() { return GraphicsEventRemoved }
  coalesce(prev) { _coalesceIds(self, prev) }
}

// Sent when an entry is replaced
class GraphicsEventReplaced is GraphicsEvent {
  init(id) {
    super.init(id)
    self.ids = [id]
    self._seen = nil
  }
  batchKey() { return GraphicsEventReplaced }
  coalesce(prev) { _coalesceIds(self, prev) }
}

// Sent when an entry's item is morphed
class GraphicsEventMorphed is GraphicsEvent {
  init(id, oldItem, newItem) {
    super.init(id)
    self.ids = [id]
    self.oldItems = Dictionary()
    self.newItems = Dictionary()
    self.oldItems[id] = oldItem
    self.newItems[id] = newItem
    self._seen = nil
  }
  batchKey() { return GraphicsEventMorphed }
  coalesce(prev) { _coalesceMorphed(self, prev) }
}

// Sent when lighting changes
class GraphicsEventLights is GraphicsEvent {
  init() { super.init(0) }
  batchKey() { return GraphicsEventLights }
  coalesce(prev) { }
}

/* ----------------------------------------------------------------
 * Scene
 * 
 * Live, updatable container paralleling Graphics. Can inform others
 * of updates using the Broadcaster/Listener protocol
 * ---------------------------------------------------------------- */

class Scene is Graphics with Broadcaster {
  init(title = nil, background = nil, light = nil) {
    super.init(title=title, background=background, light=light)
    self._broadcasterInit()
  }

  setLights(lights) {
    super.setLights(lights)
    self.notify(GraphicsEventLights())
    return true
  }

  addLight(Light l) {
    super.addLight(l)
    self.notify(GraphicsEventLights())
    return true
  }

  // Allocate id, append entry, optionally notify Defined.
  _append(item, position=nil, scale=nil, rotate=nil, color=nil, flat=nil, notify=true) {
    var id = super._append(item, position=position, scale=scale, rotate=rotate,
                           color=color, flat=flat)
    if (notify) self.notify(GraphicsEventDefined(id))
    return id
  }

  // Apply supplied pose components and notify. `position` nil leaves translation.
  _move(e, position, scale, rotate) {
    if (!isnil(position)) e.position = _asPosition(position)
    if (!isnil(scale)) e.scale = e._asScale(scale)
    if (!isnil(rotate)) e.rotate = rotate
    self.notify(GraphicsEventMoved(e.id))
    return true
  }

  // Leave position unchanged.
  move(id, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    return self._move(e, nil, scale, rotate)
  }

  // Moves an entry, setting the position, and updates scale and rotate if supplied
  move(id, position, scale=nil, rotate=nil) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    return self._move(e, position, scale, rotate)
  }

  // Set presentation color for an entry 
  recolor(id, color) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.color = e._asEntryColor(color)
    self.notify(GraphicsEventRecolored(id))
    return true
  }

  // Removes an entry 
  remove(id) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    self.displaylist.remove(e)
    self._entryById.remove(id)
    self.notify(GraphicsEventRemoved(id))
    return true
  }

  // Replaces an entry item with the provided GraphicsPrimitive
  replace(id, GraphicsPrimitive item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    e.item = item
    self.notify(GraphicsEventReplaced(id))
    return true
  }

  // Morph an entry to a new GraphicsPrimitive
  morph(id, GraphicsPrimitive item) {
    var e = self.findEntry(id)
    if (isnil(e)) return false
    var old = e.item
    e.item = item
    self.notify(GraphicsEventMorphed(id, old, item))
    return true
  }

  morph(id, item) { return false }

  replace(id, item) { return false }

  // Scene + Graphics
  add(Graphics right) {
    var g = Scene()
    self._copyMetaInto(g)
    self._joinInto(g, right)
    return g
  }

  // Append another Graphics in place; returns the new ids
  extend(Graphics right) {
    self.beginBatch()
    var ids = super.extend(right)
    self.endBatch()
    return ids
  }
}
