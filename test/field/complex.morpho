// Complex-valued Field: construct, index, arithmetic, linearize, sum, op

var m = Mesh("square.mesh")
print m
// expect: <Mesh: 4 vertices>

var f = Field(m, 1+2im)

print f[0]
// expect: 1 + 2im

// ComplexField elements are views onto the store, like MatrixField
var zview = f[0]
f[0] = 9+im
print zview
// expect: 9 + 1im
f[0] = 1+2im
print f[0]
// expect: 1 + 2im

print f.clss()
// expect: @ComplexField

print f.linearize().clss()
// expect: @Matrix

print f.linearize()
// expect: [ 1 ]
// expect: [ 2 ]
// expect: [ 1 ]
// expect: [ 2 ]
// expect: [ 1 ]
// expect: [ 2 ]
// expect: [ 1 ]
// expect: [ 2 ]

f[1] = 3
print f[1]
// expect: 3 + 0im

f[2] = 4-im
print f[2]
// expect: 4 - 1im

var g = f+f
print g[0]
// expect: 2 + 4im

print g.clss()
// expect: @ComplexField

var h = f + 1im
print h[0]
// expect: 1 + 3im

var k = (1+im)*f
print k[0]
// expect: -1 + 3im

print f.sum()
// expect: 9 + 3im

var p = Field(m, fn (x, y, z) x + y*im)
print p[0]
// expect: 0 + 0im

print p.clss()
// expect: @ComplexField

var q = f.op(fn (z) z.conj())
print q[0]
// expect: 1 - 2im

print q.clss()
// expect: @ComplexField

var r = f.clone()
r.assign(f.linearize())
print r[0]
// expect: 1 + 2im

print r.clss()
// expect: @ComplexField
