import meshtools
import "../numericalderivatives.morpho"

var mb = MeshBuilder()
mb.addvertex([0,0,0])
mb.addvertex([1,0,0])
mb.addvertex([0,1,0])
mb.addvertex([1,1,0])
mb.addface([0,1,2])
mb.addface([1,3,2])

var m = mb.build()
m.addgrade(1)

var fe = FiniteElementSpace("CG3", grade=2)
var f = Field(m, fn (x,y,z) x^3*y, finiteelementspace=fe)

var j = Jump(fn (x, q) jumpdn(q)^2, f, method={ "strategy": "quadrature" })
var tol = 2e-5

print (j.gradient(m) - numericalgradient(j, m)).norm() < tol
// expect: true

print (j.fieldgradient(f, m) - numericalfieldgradient(j, m, f)).linearize().norm() < tol
// expect: true
