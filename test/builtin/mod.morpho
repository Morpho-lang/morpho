// Mod function

print mod(5, 3)
// expect: 2

print mod(5.3, 3)
// expect: 2.3

print mod(4, 2.5)
// expect: 1.5

print mod(3.4, 1.1)
// expect: 0.1

try {
    print mod(1,2,3)
} catch {
    "InvldArgs" : print "ok"
}
// expect: ok

try {
    print mod(1.5,2,3)
} catch {
    "InvldArgs" : print "ok"
}
// expect: ok
